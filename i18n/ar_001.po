#. module: vehicle_rental
#: model:mail.template,body_html:vehicle_rental.vehicle_rental_booking_mail_template
msgid ""
"<table style=\"width: 100%\">\n"
"                    <tr>\n"
"                        <td>\n"
"                            Dear Customer,\n"
"                            <br>\n"
"                            <h4>\n"
"                                <strong>\n"
"                                    <t t-out=\"object.customer_id.name\"></t>\n"
"                                </strong>\n"
"                            </h4>\n"
"                        </td>\n"
"                    </tr>\n"
"                </table>\n"
"                <p>\n"
"                    We are excited about your upcoming journey with us and want to ensure that you have all the\n"
"                    necessary information regarding the rental contract.\n"
"                </p>\n"
"                <hr>\n"
"                <table>\n"
"                    <tr>\n"
"                        <td>\n"
"                            <strong>\n"
"                                Please review the following details:\n"
"                            </strong>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td>\n"
"                            <strong>\n"
"                                Reference Number:\n"
"                            </strong>\n"
"                        </td>\n"
"                        <td>\n"
"                            <t t-out=\"object.reference_no\"></t>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td>\n"
"                            <strong>\n"
"                                Vehicle:\n"
"                            </strong>\n"
"                        </td>\n"
"                        <td>\n"
"                            <t t-out=\"object.vehicle_id.name\"></t>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td>\n"
"                            <strong>\n"
"                                Pick-Up Date:\n"
"                            </strong>\n"
"                        </td>\n"
"                        <td>\n"
"                            <t t-out=\"object.start_date\"></t>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td>\n"
"                            <strong>\n"
"                                Pick-Up Location:\n"
"                            </strong>\n"
"                        </td>\n"
"                        <td>\n"
"                            <t t-out=\"object.pick_up_street\"></t> , \n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td>\n"
"                        </td>\n"
"                        <td>\n"
"                            <t t-out=\"object.pick_up_street2\"></t> , \n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td>\n"
"                        </td>\n"
"                        <td>\n"
"                            <t t-out=\"object.pick_up_city\"></t> , \n"
"                            <t t-out=\"object.pick_up_state_id.name\"></t> , \n"
"                            <t t-out=\"object.pick_up_zip\"></t>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td>\n"
"                        </td>\n"
"                        <td>\n"
"                            <t t-out=\"object.pick_up_country_id.name\"></t>\n"
"                        </td>\n"
"                    </tr>\n"
"\n"
"                    <tr>\n"
"                        <td>\n"
"                            <strong>\n"
"                                Drop-Off Date:\n"
"                            </strong>\n"
"                        </td>\n"
"                        <td>\n"
"                            <t t-out=\"object.end_date\"></t>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td>\n"
"                            <strong>\n"
"                                Drop-Off Location:\n"
"                            </strong>\n"
"                        </td>\n"
"                        <td>\n"
"                            <t t-out=\"object.drop_off_street\"></t> , \n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td>\n"
"                        </td>\n"
"                        <td>\n"
"                            <t t-out=\"object.drop_off_street2\"></t> , \n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td>\n"
"                        </td>\n"
"                        <td>\n"
"                            <t t-out=\"object.drop_off_city\"></t> , \n"
"                            <t t-out=\"object.drop_off_state_id.name\"></t> , \n"
"                            <t t-out=\"object.drop_off_zip\"></t>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td>\n"
"                        </td>\n"
"                        <td>\n"
"                            <t t-out=\"object.drop_off_country_id.name\"></t>\n"
"                        </td>\n"
"                    </tr>\n"
"                </table>\n"
"                <hr>\n"
"                <p>\n"
"                    Before your journey, please familiarize yourself with the rental agreement, which outlines the terms\n"
"                    and conditions. To access the agreement, visit\n"
"                    <strong>\n"
"                        <t t-out=\"object.company_id.website\"></t>\n"
"                    </strong>\n"
"                    or contact our customer support team. Ensure that your insurance coverage is adequate and that all\n"
"                    drivers meet the requirements. A security deposit may be required at pickup, refundable upon the\n"
"                    vehicle's return. Conduct a thorough inspection before your journey, noting any pre-existing\n"
"                    damages. For any questions or concerns, reach out to our customer support team at\n"
"                    <strong>\n"
"                        <t t-out=\"object.company_id.phone\"></t>\n"
"                    </strong>\n"
"                    We appreciate your trust and wish you a fantastic journey!\n"
"                </p>\n"
"                <h6>\n"
"                    Best regards,\n"
"                </h6>\n"
"                <h5>\n"
"                    <strong>\n"
"                        <t t-out=\"object.responsible_id.name\"></t>\n"
"                    </strong>\n"
"                </h5>\n"
"                <hr>\n"
"                <span>\n"
"                    <h6>\n"
"                        <t t-out=\"object.company_id.name\"></t>\n"
"                    </h6>\n"
"                    <t t-out=\"object.company_id.phone\"></t>\n"
"                    <br>\n"
"                    <t t-out=\"object.company_id.email\"></t>\n"
"                    <br>\n"
"                    <t t-out=\"object.company_id.website\"></t>\n"
"                </span>\n"
"            "
msgstr ""
"<table style=\"width: 100%\">\n"
"                    <tr>\n"
"                        <td>\n"
"                           عزيزي العميل،\n"
"                            <br>\n"
"                            <h4>\n"
"                                <strong>\n"
"                                    <t t-out=\"object.customer_id.name\"></t>\n"
"                                </strong>\n"
"                            </h4>\n"
"                        </td>\n"
"                    </tr>\n"
"                </table>\n"
"                <p>\n"
"                    نحن متحمسون لرحلتك القادمة معنا ونريد التأكد من حصولك على كل ما تحتاجه\n"
"                   المعلومات اللازمة فيما يتعلق بعقد الإيجار.\n"
"                </p>\n"
"                <hr>\n"
"                <table>\n"
"                    <tr>\n"
