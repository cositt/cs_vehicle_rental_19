"                            </strong>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td>\n"
"                            <strong>\n"
"                               رقم المرجع:\n"
"                            </strong>\n"
"                        </td>\n"
"                        <td>\n"
"                            <t t-out=\"object.reference_no\"></t>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td>\n"
"                            <strong>\n"
"                               عربة:\n"
"                            </strong>\n"
"                        </td>\n"
"                        <td>\n"
"                            <t t-out=\"object.vehicle_id.name\"></t>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td>\n"
"                            <strong>\n"
"                               اختر تاريخا:\n"
"                            </strong>\n"
"                        </td>\n"
"                        <td>\n"
"                            <t t-out=\"object.start_date\"></t>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td>\n"
"                            <strong>\n"
"                               اختر موقعا:\n"
"                            </strong>\n"
"                        </td>\n"
"                        <td>\n"
"                            <t t-out=\"object.pick_up_street\"></t> , \n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td>\n"
"                        </td>\n"
"                        <td>\n"
"                            <t t-out=\"object.pick_up_street2\"></t> , \n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td>\n"
"                        </td>\n"
"                        <td>\n"
"                            <t t-out=\"object.pick_up_city\"></t> , \n"
"                            <t t-out=\"object.pick_up_state_id.name\"></t> , \n"
"                            <t t-out=\"object.pick_up_zip\"></t>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td>\n"
"                        </td>\n"
"                        <td>\n"
"                            <t t-out=\"object.pick_up_country_id.name\"></t>\n"
"                        </td>\n"
"                    </tr>\n"
"\n"
"                    <tr>\n"
"                        <td>\n"
"                            <strong>\n"
"                               تاريخ التسليم:\n"
"                            </strong>\n"
"                        </td>\n"
