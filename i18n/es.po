#. module: vehicle_rental
#: model:mail.template,body_html:vehicle_rental.email_template_vehicle_contract_return
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px; font-family: Arial, sans-serif;\">\n"
"                    <p>Estimado/a <t t-out=\"object.contract_id.customer_id.name or 'cliente'\"/>,</p>\n"
"\n"
"                    <p>\n"
"                        Le confirmamos que el vehículo ha sido <strong>devuelto correctamente</strong> y que su\n"
"                        contrato de alquiler <strong><t t-out=\"object.contract_id.reference_no\"/></strong>\n"
"                        ha quedado <strong>finalizado</strong> con fecha\n"
"                        <t t-out=\"format_datetime(object.return_date, dt_format='dd/MM/yyyy HH:mm')\"/>.\n"
"                    </p>\n"
"\n"
"                    <p>A continuación encontrará el resumen completo del proceso:</p>\n"
"\n"
"                    <!-- Datos del alquiler -->\n"
"                    <h3 style=\"color: #17a2b8; border-bottom: 2px solid #17a2b8; padding-bottom: 4px;\">\n"
"                        Datos del alquiler\n"
"                    </h3>\n"
"                    <table style=\"width: 100%; border-collapse: collapse; font-size: 13px;\">\n"
"                        <tr>\n"
"                            <td style=\"padding: 5px; font-weight: bold; width: 45%;\">Contrato:</td>\n"
"                            <td style=\"padding: 5px;\"><t t-out=\"object.contract_id.reference_no\"/></td>\n"
"                        </tr>\n"
"                        <tr style=\"background-color: #f8f9fa;\">\n"
"                            <td style=\"padding: 5px; font-weight: bold;\">Vehículo devuelto:</td>\n"
"                            <td style=\"padding: 5px;\">\n"
"                                <t t-out=\"object.vehicle_id.name\"/>\n"
"                                (<t t-out=\"object.vehicle_id.license_plate or '-'\"/>)\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding: 5px; font-weight: bold;\">Fecha de recogida:</td>\n"
"                            <td style=\"padding: 5px;\">\n"
"                                <t t-out=\"format_datetime(object.contract_id.start_date, dt_format='dd/MM/yyyy HH:mm') if object.contract_id.start_date else '-'\"/>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr style=\"background-color: #f8f9fa;\">\n"
"                            <td style=\"padding: 5px; font-weight: bold;\">Fecha de devolución:</td>\n"
"                            <td style=\"padding: 5px;\">\n"
"                                <t t-out=\"format_datetime(object.return_date, dt_format='dd/MM/yyyy HH:mm')\"/>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </table>\n"
"\n"
"                    <!-- Estado del veh&#237;culo -->\n"
"                    <h3 style=\"color: #17a2b8; border-bottom: 2px solid #17a2b8; padding-bottom: 4px;\">\n"
"                        Estado del vehículo\n"
"                    </h3>\n"
"                    <table style=\"width: 100%; border-collapse: collapse; font-size: 13px;\">\n"
"                        <tr style=\"background-color: #e9ecef;\">\n"
"                            <td style=\"padding: 5px; font-weight: bold; width: 45%;\"/>\n"
"                            <td style=\"padding: 5px; font-weight: bold;\">En la entrega</td>\n"
"                            <td style=\"padding: 5px; font-weight: bold;\">En la devolución</td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding: 5px; font-weight: bold;\">Kilometraje:</td>\n"
"                            <td style=\"padding: 5px;\">\n"
"                                <t t-out=\"'{:,.0f}'.format(object.odometer_start)\"/>\n"
"                                <t t-out=\"'km' if object.odometer_unit == 'kilometers' else 'mi'\"/>\n"
"                            </td>\n"
"                            <td style=\"padding: 5px;\">\n"
"                                <strong>\n"
"                                    <t t-out=\"'{:,.0f}'.format(object.odometer)\"/>\n"
"                                    <t t-out=\"'km' if object.odometer_unit == 'kilometers' else 'mi'\"/>\n"
"                                </strong>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr style=\"background-color: #f8f9fa;\">\n"
"                            <td style=\"padding: 5px; font-weight: bold;\">Combustible:</td>\n"
"                            <td style=\"padding: 5px;\">\n"
"                                <t t-out=\"object.fuel_label(object.fuel_level_start) if object.fuel_level_start else 'No registrado'\"/>\n"
"                            </td>\n"
"                            <td style=\"padding: 5px;\">\n"
"                                <strong><t t-out=\"object.fuel_label(object.fuel_level)\"/></strong>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding: 5px; font-weight: bold;\">Kilómetros recorridos:</td>\n"
"                            <td style=\"padding: 5px;\" colspan=\"2\">\n"
"                                <strong>\n"
"                                    <t t-out=\"'{:,.0f}'.format(object.km_driven)\"/>\n"
"                                    <t t-out=\"'km' if object.odometer_unit == 'kilometers' else 'mi'\"/>\n"
"                                </strong>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </table>\n"
"\n"
"                    <!-- Inspecci&#243;n -->\n"
"                    <h3 style=\"color: #17a2b8; border-bottom: 2px solid #17a2b8; padding-bottom: 4px;\">\n"
"                        Inspección de daños\n"
"                    </h3>\n"
"                    <div t-if=\"not object.has_damage\" style=\"background-color: #d4edda; border: 1px solid #c3e6cb; padding: 10px; border-radius: 4px;\">\n"
"                        El vehículo fue inspeccionado en el momento de la devolución y\n"
"                        <strong>no se detectaron daños</strong> más allá del desgaste normal por el uso.\n"
"                    </div>\n"
"                    <div t-if=\"object.has_damage\" style=\"background-color: #fff3cd; border: 1px solid #ffeeba; padding: 10px; border-radius: 4px;\">\n"
"                        <strong>Se detectaron daños en la inspección.</strong>\n"
"                        <div style=\"margin-top: 8px;\"><t t-out=\"object.damage_description\"/></div>\n"
"                        <div style=\"margin-top: 8px;\">\n"
"                            Importe estimado:\n"
"                            <strong>\n"
"                                <t t-out=\"'{:,.2f}'.format(object.damage_amount)\"/>\n"
"                                <t t-out=\"object.currency_id.symbol or ''\"/>\n"
"                            </strong>\n"
"                        </div>\n"
"                    </div>\n"
"\n"
"                    <!-- Modificaciones del contrato -->\n"
"                    <t t-set=\"subs\" t-value=\"object.contract_id.substitution_ids\"/>\n"
"                    <t t-set=\"exts\" t-value=\"object.contract_id.extension_ids\"/>\n"
"                    <div t-if=\"subs or exts\">\n"
"                        <h3 style=\"color: #17a2b8; border-bottom: 2px solid #17a2b8; padding-bottom: 4px;\">\n"
"                            Modificaciones durante el alquiler\n"
"                        </h3>\n"
"                        <ul style=\"font-size: 13px;\">\n"
"                            <li t-foreach=\"subs\" t-as=\"sub\">\n"
"                                <strong>Sustitución de vehículo</strong>\n"
"                                (<t t-out=\"format_date(sub.substitution_date)\"/>):\n"
"                                <t t-out=\"sub.old_vehicle_id.license_plate or '-'\"/> →\n"
"                                <t t-out=\"sub.new_vehicle_id.license_plate or '-'\"/>\n"
"                            </li>\n"
"                            <li t-foreach=\"exts\" t-as=\"ext\">\n"
"                                <strong>Ampliación de contrato</strong>\n"
"                                (<t t-out=\"'{:,.0f}'.format(ext.extension_days)\"/> días):\n"
"                                fin <t t-out=\"format_date(ext.original_end_date) if ext.original_end_date else '-'\"/>\n"
"                                → <t t-out=\"format_date(ext.new_end_date) if ext.new_end_date else '-'\"/>\n"
"                            </li>\n"
"                        </ul>\n"
"                    </div>\n"
"\n"
"                    <!-- Facturaci&#243;n -->\n"
"                    <t t-set=\"invoices\" t-value=\"object.get_process_invoices()\"/>\n"
"                    <div t-if=\"invoices\">\n"
"                        <h3 style=\"color: #17a2b8; border-bottom: 2px solid #17a2b8; padding-bottom: 4px;\">\n"
"                            Resumen de facturación\n"
"                        </h3>\n"
"                        <table style=\"width: 100%; border-collapse: collapse; font-size: 13px;\">\n"
"                            <tr style=\"background-color: #e9ecef;\">\n"
"                                <td style=\"padding: 5px; font-weight: bold;\">Documento</td>\n"
"                                <td style=\"padding: 5px; font-weight: bold;\">Fecha</td>\n"
"                                <td style=\"padding: 5px; font-weight: bold; text-align: right;\">Importe</td>\n"
"                                <td style=\"padding: 5px; font-weight: bold;\">Estado</td>\n"
"                            </tr>\n"
"                            <tr t-foreach=\"invoices\" t-as=\"inv\">\n"
"                                <td style=\"padding: 5px; border-top: 1px solid #dee2e6;\">\n"
"                                    <t t-out=\"inv.name or 'Borrador'\"/>\n"
"                                </td>\n"
"                                <td style=\"padding: 5px; border-top: 1px solid #dee2e6;\">\n"
"                                    <t t-out=\"format_date(inv.invoice_date) if inv.invoice_date else '-'\"/>\n"
"                                </td>\n"
"                                <td style=\"padding: 5px; border-top: 1px solid #dee2e6; text-align: right;\">\n"
"                                    <t t-out=\"'{:,.2f}'.format(inv.amount_total)\"/>\n"
"                                    <t t-out=\"inv.currency_id.symbol or ''\"/>\n"
"                                </td>\n"
"                                <td style=\"padding: 5px; border-top: 1px solid #dee2e6;\">\n"
"                                    <t t-out=\"'Pagada' if inv.payment_state in ('paid', 'in_payment') else 'Pendiente'\"/>\n"
"                                </td>\n"
"                            </tr>\n"
"                        </table>\n"
"                    </div>\n"
"\n"
"                    <p style=\"margin-top: 20px;\">\n"
"                        Adjuntamos el <strong>acta de devolución</strong> con el detalle completo y firmado\n"
"                        del estado del vehículo.\n"
"                    </p>\n"
"\n"
"                    <p>Gracias por confiar en nosotros. Esperamos volver a atenderle pronto.</p>\n"
"\n"
"                    <p>Atentamente,<br/>\n"
"                        El equipo de <t t-out=\"object.contract_id.owner_company_id.name\"/>\n"
"                    </p>\n"
"\n"
"                    <hr style=\"margin: 16px 0px; border: none; border-top: 1px solid #e1e1e1;\"/>\n"
"\n"
"                    <p style=\"font-size: 11px; color: #666;\">\n"
"                        Este es un mensaje automático. Si detecta cualquier discrepancia en este resumen,\n"
"                        por favor contacte con nosotros lo antes posible.\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: vehicle_rental
#: model:mail.template,body_html:vehicle_rental.vehicle_rental_booking_mail_template
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                <p>Estimado/a <t t-out=\"object.customer_id.name or 'cliente'\"/>,</p>\n"
"                <p>Le confirmamos los datos de su alquiler. Por favor, revíselos:</p>\n"
"                <table style=\"width: 100%; border-collapse: collapse;\">\n"
"                    <tr>\n"
"                        <td style=\"width: 40%;\"><strong>Contrato:</strong></td>\n"
"                        <td><t t-out=\"object.reference_no\"/></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"width: 40%;\"><strong>Vehículo:</strong></td>\n"
"                        <td><t t-out=\"object.vehicle_id.name or ''\"/></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"width: 40%;\"><strong>Recogida:</strong></td>\n"
"                        <td><t t-out=\"format_datetime(object.start_date, tz='Europe/Madrid', dt_format='dd/MM/yyyy HH:mm')\"/></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"width: 40%;\"><strong>Lugar de recogida:</strong></td>\n"
"                        <td>\n"
"                            <t t-out=\"', '.join([p for p in [object.pick_up_street, object.pick_up_street2] if p])\"/>\n"
"                            <br/>\n"
"                            <t t-out=\"' '.join([p for p in [object.pick_up_zip, object.pick_up_city] if p])\"/>\n"
"                            <t t-if=\"object.pick_up_state_id and object.pick_up_state_id.name != object.pick_up_city\">\n"
"                                (<t t-out=\"object.pick_up_state_id.name\"/>)\n"
"                            </t>\n"
"                            <t t-if=\"object.pick_up_country_id\">\n"
"                                <br/><t t-out=\"object.pick_up_country_id.name\"/>\n"
"                            </t>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"width: 40%;\"><strong>Devolución:</strong></td>\n"
"                        <td><t t-out=\"format_datetime(object.end_date, tz='Europe/Madrid', dt_format='dd/MM/yyyy HH:mm')\"/></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"width: 40%;\"><strong>Lugar de devolución:</strong></td>\n"
"                        <td>\n"
"                            <t t-out=\"', '.join([p for p in [object.drop_off_street, object.drop_off_street2] if p])\"/>\n"
"                            <br/>\n"
"                            <t t-out=\"' '.join([p for p in [object.drop_off_zip, object.drop_off_city] if p])\"/>\n"
"                            <t t-if=\"object.drop_off_state_id and object.drop_off_state_id.name != object.drop_off_city\">\n"
"                                (<t t-out=\"object.drop_off_state_id.name\"/>)\n"
"                            </t>\n"
"                            <t t-if=\"object.drop_off_country_id\">\n"
"                                <br/><t t-out=\"object.drop_off_country_id.name\"/>\n"
"                            </t>\n"
"                        </td>\n"
"                    </tr>\n"
"                </table>\n"
"                <p>\n"
"                    Antes de recoger el vehículo, lea las condiciones del contrato. Compruebe que su seguro es\n"
"                    adecuado y que todos los conductores cumplen los requisitos. En la recogida se le pedirá\n"
"                    una fianza, que se devuelve al entregar el vehículo. Revise el vehículo antes de salir y\n"
"                    anote cualquier daño previo.\n"
"                </p>\n"
"                <p>\n"
"                    Para cualquier duda, contacte con nosotros<t t-if=\"object.owner_company_id.phone\"> en el\n"
"                    <strong><t t-out=\"object.owner_company_id.phone\"/></strong></t>.\n"
"                    ¡Gracias por su confianza y buen viaje!\n"
"                </p>\n"
"                <p>\n"
"                    Atentamente,<br/>\n"
"                    <strong><t t-out=\"object.responsible_id.name\"/></strong>\n"
"                </p>\n"
"                <hr style=\"border: none; border-top: 1px solid #e1e1e1;\"/>\n"
"                <p style=\"font-size: 12px; color: #666;\">\n"
"                    <strong><t t-out=\"object.owner_company_id.name\"/></strong>\n"
"                    <t t-if=\"object.owner_company_id.phone\"><br/><t t-out=\"object.owner_company_id.phone\"/></t>\n"
"                    <t t-if=\"object.owner_company_id.email\"><br/><t t-out=\"object.owner_company_id.email\"/></t>\n"
"                    <t t-if=\"object.owner_company_id.website\"><br/><t t-out=\"object.owner_company_id.website\"/></t>\n"
"                </p>\n"
"            </div>\n"
"            "
msgstr ""

