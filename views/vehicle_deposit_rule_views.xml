<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- vehicle.deposit.rule Tree View -->
        <record id="vehicle_deposit_rule_tree" model="ir.ui.view">
            <field name="name">vehicle.deposit.rule.tree</field>
            <field name="model">vehicle.deposit.rule</field>
            <field name="arch" type="xml">
                <tree string="Reglas de Depósito" decoration-muted="not active">
                    <field name="name"/>
                    <field name="vehicle_category_id"/>
                    <field name="card_type" widget="badge" decoration-warning="card_type == 'debit'" decoration-info="card_type == 'credit'"/>
                    <field name="deposit_fixed" widget="monetary"/>
                    <field name="deposit_percentage" widget="float" string="% Alquiler"/>
                    <field name="valid_from"/>
                    <field name="valid_until"/>
                    <field name="active" widget="boolean_toggle"/>
                </tree>
            </field>
        </record>

        <!-- vehicle.deposit.rule Form View -->
        <record id="vehicle_deposit_rule_form" model="ir.ui.view">
            <field name="name">vehicle.deposit.rule.form</field>
            <field name="model">vehicle.deposit.rule</field>
            <field name="arch" type="xml">
                <form string="Regla de Depósito">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                                <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                            </button>
                        </div>

                        <h1>
                            <field name="name" readonly="1" class="mb-0"/>
                        </h1>

                        <group>
                            <group>
                                <field name="vehicle_category_id" required="1"/>
                                <field name="card_type" required="1" widget="radio"/>
                            </group>
                            <group>
                                <field name="valid_from" required="1"/>
                                <field name="valid_until"/>
                            </group>
                        </group>

                        <separator string="Configuración de Depósito"/>
                        <group>
                            <group>
                                <field name="deposit_fixed" widget="monetary"/>
                                <field name="deposit_percentage" widget="float"/>
                                <field name="apply_both" widget="boolean"/>
                            </group>
                            <group>
                                <field name="min_deposit" widget="monetary"/>
                                <field name="max_deposit" widget="monetary"/>
                            </group>
                        </group>

                        <separator string="Información Adicional"/>
                        <group>
                            <group>
                                <field name="currency_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>

                        <separator string="Notas"/>
                        <field name="notes" nolabel="1" placeholder="Condiciones especiales, restricciones, etc."/>
                    </sheet>

                    <div class="oe_chatter">
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- vehicle.deposit.rule Search View -->
        <record id="vehicle_deposit_rule_search" model="ir.ui.view">
            <field name="name">vehicle.deposit.rule.search</field>
            <field name="model">vehicle.deposit.rule</field>
            <field name="arch" type="xml">
                <search string="Buscar Reglas de Depósito">
                    <field name="vehicle_category_id"/>
                    <field name="card_type"/>
                    <field name="valid_from"/>
                    <filter string="Activas" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Inactivas" name="inactive" domain="[('active', '=', False)]"/>
                    <separator/>
                    <filter string="Débito" name="debit" domain="[('card_type', '=', 'debit')]"/>
                    <filter string="Crédito" name="credit" domain="[('card_type', '=', 'credit')]"/>
                    <group expand="0" string="Agrupar por">
                        <filter string="Categoría de Vehículo" name="group_category" context="{'group_by': 'vehicle_category_id'}"/>
                        <filter string="Tipo de Tarjeta" name="group_card_type" context="{'group_by': 'card_type'}"/>
                        <filter string="Vigencia Desde" name="group_valid_from" context="{'group_by': 'valid_from'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="vehicle_deposit_rule_action" model="ir.actions.act_window">
            <field name="name">Reglas de Depósitos Dinámicos</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">vehicle.deposit.rule</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear una nueva regla de depósito dinámico
                </p>
                <p>
                    Las reglas de depósito se aplican automáticamente basadas en:
                    <ul>
                        <li>Categoría de vehículo</li>
                        <li>Tipo de tarjeta (débito o crédito)</li>
                        <li>Precio del alquiler</li>
                    </ul>
                </p>
            </field>
        </record>

    </data>
</odoo>
