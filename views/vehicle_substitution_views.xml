<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================ -->
    <!-- Vehicle Contract Substitution Views -->
    <!-- ============================================ -->

    <!-- List View -->
    <record id="vehicle_contract_substitution_tree_view" model="ir.ui.view">
        <field name="name">vehicle.contract.substitution.tree</field>
        <field name="model">vehicle.contract.substitution</field>
        <field name="arch" type="xml">
            <list string="Sustituciones de Vehículos" create="false">
                <field name="substitution_date"/>
                <field name="contract_id"/>
                <field name="old_vehicle_id"/>
                <field name="new_vehicle_id"/>
                <field name="reason"/>
                <field name="old_vehicle_has_damage"/>
                <field name="old_vehicle_damage_amount"/>
                <field name="price_difference"/>
                <field name="addendum_generated"/>
                <field name="responsible_id"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="vehicle_contract_substitution_form_view" model="ir.ui.view">
        <field name="name">vehicle.contract.substitution.form</field>
        <field name="model">vehicle.contract.substitution</field>
        <field name="arch" type="xml">
            <form string="Sustitución de Vehículo" create="false" edit="false">
                <header>
                    <button name="action_generate_addendum" 
                            string="Generar Addendum" 
                            type="object" 
                            class="btn-primary"
                            invisible="addendum_generated"/>
                    <button name="action_create_damage_invoice" 
                            string="Facturar Daños" 
                            type="object"
                            class="btn-secondary"
                            invisible="not old_vehicle_has_damage or old_vehicle_damage_amount == 0"/>
                    <button name="action_create_price_difference_invoice" 
                            string="Facturar Diferencia de Precio" 
                            type="object"
                            class="btn-secondary"
                            invisible="not has_price_difference or price_difference == 0 or price_difference_invoice_id"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_report_vehicle_substitution_addendum)d" 
                                type="action" 
                                class="oe_stat_button" 
                                icon="fa-file-pdf-o"
                                string="Ver Addendum"
                                invisible="not addendum_generated"/>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Información General">
                            <field name="contract_id"/>
                            <field name="substitution_date"/>
                            <field name="reason"/>
                            <field name="reason_notes"/>
                            <field name="responsible_id"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Documentación">
                            <field name="addendum_generated"/>
                            <field name="addendum_pdf" filename="addendum_filename" invisible="not addendum_generated"/>
                            <field name="addendum_filename" invisible="1"/>
                            <field name="signature_date"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <!-- Tab: Vehículo Original (Devuelto) -->
                        <page string="Vehículo Original" name="old_vehicle">
                            <group>
                                <group string="Identificación">
                                    <field name="old_vehicle_id"/>
                                </group>
                                <group string="Estado de Devolución">
                                    <field name="old_vehicle_odometer"/>
                                    <field name="old_vehicle_fuel_level"/>
                                </group>
                            </group>
                            
                            <group string="Daños" invisible="not old_vehicle_has_damage">
                                <field name="old_vehicle_has_damage"/>
                                <field name="old_vehicle_damage_description" invisible="not old_vehicle_has_damage"/>
                                <field name="old_vehicle_damage_amount" invisible="not old_vehicle_has_damage"/>
                            </group>
                            
                            <group string="Imagen de Daños" invisible="not old_vehicle_painted_damage_image">
                                <field name="old_vehicle_painted_damage_image" 
                                       widget="image" 
                                       options="{'size': [800, 600]}"
                                       invisible="not old_vehicle_painted_damage_image"/>
                            </group>
                            
                            <field name="old_vehicle_damage_images" 
                                   widget="many2many_binary" 
                                   string="Fotos de Daños"
                                   invisible="not old_vehicle_has_damage"/>
                        </page>
                        
                        <!-- Tab: Vehículo Sustituto (Entregado) -->
                        <page string="Vehículo Sustituto" name="new_vehicle">
                            <group>
                                <group string="Identificación">
                                    <field name="new_vehicle_id"/>
                                </group>
                                <group string="Estado de Entrega">
                                    <field name="new_vehicle_odometer"/>
                                    <field name="new_vehicle_fuel_level"/>
                                </group>
                            </group>
                            
                            <group string="Daños Previos" invisible="not new_vehicle_has_damage">
                                <field name="new_vehicle_has_damage"/>
                                <field name="new_vehicle_damage_description" invisible="not new_vehicle_has_damage"/>
                            </group>
                            
                            <group string="Imagen de Daños Previos" invisible="not new_vehicle_painted_damage_image">
                                <field name="new_vehicle_painted_damage_image" 
                                       widget="image" 
                                       options="{'size': [800, 600]}"
                                       invisible="not new_vehicle_painted_damage_image"/>
                            </group>
                            
                            <field name="new_vehicle_damage_images" 
                                   widget="many2many_binary" 
                                   string="Fotos de Daños Previos"
                                   invisible="not new_vehicle_has_damage"/>
                        </page>
                        
                        <!-- Tab: Diferencia de Precio -->
                        <page string="Diferencia de Precio" name="price_difference" invisible="not has_price_difference">
                            <group>
                                <field name="has_price_difference" invisible="1"/>
                                <field name="price_difference"/>
                                <field name="price_difference_invoice_id"/>
                            </group>
                            <group string="Nota" col="1">
                                <p class="alert alert-info" role="alert">
                                    <i class="fa fa-info-circle"/> 
                                    Si el valor es <b>positivo</b>, el cliente debe pagar la diferencia.<br/>
                                    Si el valor es <b>negativo</b>, se debe reembolsar al cliente.
                                </p>
                            </group>
                        </page>
                        
                        <!-- Tab: Firmas -->
                        <page string="Firmas" name="signatures">
                            <group>
                                <group string="Firma del Cliente">
                                    <field name="customer_signature" widget="image"/>
                                </group>
                                <group string="Firma de la Empresa">
                                    <field name="company_signature" widget="image"/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- Tab: Notas -->
                        <page string="Notas Adicionales" name="notes">
                            <field name="notes" placeholder="Notas adicionales sobre la sustitución..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="vehicle_contract_substitution_search_view" model="ir.ui.view">
        <field name="name">vehicle.contract.substitution.search</field>
        <field name="model">vehicle.contract.substitution</field>
        <field name="arch" type="xml">
            <search string="Buscar Sustituciones">
                <field name="contract_id"/>
                <field name="old_vehicle_id"/>
                <field name="new_vehicle_id"/>
                <field name="reason"/>
                <separator/>
                <filter string="Con Daños" name="with_damage" domain="[('old_vehicle_has_damage', '=', True)]"/>
                <filter string="Con Diferencia de Precio" name="with_price_diff" domain="[('has_price_difference', '=', True)]"/>
                <filter string="Addendum Generado" name="addendum_done" domain="[('addendum_generated', '=', True)]"/>
                <separator/>
                <filter string="Avería" name="breakdown" domain="[('reason', '=', 'breakdown')]"/>
                <filter string="Accidente" name="accident" domain="[('reason', '=', 'accident')]"/>
                <filter string="Mantenimiento" name="maintenance" domain="[('reason', '=', 'maintenance')]"/>
                <separator/>
            </search>
        </field>
    </record>

    <!-- Heredar vista contrato: tab inline de sustituciones -->
    <record id="vehicle_contract_form_view_substitution_tab" model="ir.ui.view">
        <field name="name">vehicle.contract.form.view.substitution.tab</field>
        <field name="model">vehicle.contract</field>
        <field name="inherit_id" ref="vehicle_rental.vehicle_contract_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='damage']" position="after">
                <page name="contract_substitutions" string="Sustituciones"
                      invisible="substitution_count == 0">
                    <field name="substitution_ids" nolabel="1" readonly="1">
                        <list create="0" delete="0" edit="0"
                              decoration-danger="old_vehicle_has_damage">
                            <field name="substitution_date"/>
                            <field name="old_vehicle_id"/>
                            <field name="new_vehicle_id"/>
                            <field name="reason"/>
                            <field name="old_vehicle_has_damage" widget="boolean_toggle"/>
                            <field name="old_vehicle_damage_amount" widget="monetary"/>
                            <field name="price_difference" widget="monetary"/>
                            <field name="addendum_generated" widget="boolean_toggle"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Action -->
    <record id="action_vehicle_contract_substitution" model="ir.actions.act_window">
        <field name="name">Sustituciones de Vehículos</field>
        <field name="res_model">vehicle.contract.substitution</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay sustituciones registradas
            </p>
            <p>
                Las sustituciones de vehículos se crean desde los contratos en progreso.
            </p>
        </field>
    </record>

</odoo>

