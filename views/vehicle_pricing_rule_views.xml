<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================ -->
    <!-- VISTAS DE TARIFAS DE VEHÍCULOS -->
    <!-- ============================================ -->

    <!-- Vista Tree (Lista) -->
    <record id="view_vehicle_pricing_rule_tree" model="ir.ui.view">
        <field name="name">vehicle.pricing.rule.tree</field>
        <field name="model">vehicle.pricing.rule</field>
        <field name="arch" type="xml">
            <list string="Tarifas de Vehículos" 
                  decoration-muted="not active"
                  decoration-info="pricing_type == 'flexirent'">
                <field name="active" column_invisible="1"/>
                <field name="vehicle_category_id"/>
                <field name="pricing_type" string="Tipo"/>
                <field name="km_limit" string="Km Límite" optional="show"/>
                <field name="duration_range" string="Duración" optional="show"/>
                <field name="km_included" string="Km Incluidos" optional="show"/>
                <field name="package_days" string="Días Paquete" optional="show"/>
                <field name="price_per_unit" widget="monetary" string="Precio/Día"/>
                <field name="price_without_vat" widget="monetary" optional="show" string="Sin IVA"/>
                <field name="valid_from" string="Vigente Desde"/>
                <field name="valid_until" optional="hide" string="Vigente Hasta"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Vista Form (Formulario) -->
    <record id="view_vehicle_pricing_rule_form" model="ir.ui.view">
        <field name="name">vehicle.pricing.rule.form</field>
        <field name="model">vehicle.pricing.rule</field>
        <field name="arch" type="xml">
            <form string="Tarifa de Vehículo">
                <header>
                    <button name="action_duplicate_with_new_dates" 
                            string="Duplicar con Nuevas Fechas" 
                            type="object" 
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    
                    <widget name="web_ribbon" title="Inactiva" bg_color="bg-danger" 
                            invisible="active"/>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Información General">
                            <field name="vehicle_category_id" required="1"/>
                            <field name="pricing_type" widget="radio"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Vigencia">
                            <field name="valid_from" required="1"/>
                            <field name="valid_until"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- TAB: Configuración Estándar -->
                        <page string="Configuración Estándar" 
                              invisible="pricing_type != 'standard'">
                            <group>
                                <group>
                                    <field name="km_range" required="pricing_type == 'standard'"/>
                                    <field name="duration_range" required="pricing_type == 'standard'"/>
                                </group>
                                <group>
                                    <label for="price_per_unit" string="Precio"/>
                                    <div class="o_row">
                                        <field name="price_per_unit" required="1"/>
                                        <span> (IVA inc.) = </span>
                                        <field name="price_without_vat" readonly="1"/>
                                        <span> (sin IVA)</span>
                                    </div>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                            </group>
                            
                            <div class="alert alert-info" role="alert">
                                <i class="fa fa-info-circle"/> 
                                Esta tarifa se aplica por <strong>día de alquiler</strong>. 
                                El total se calcula multiplicando este precio por el número de días.
                            </div>
                        </page>

                        <!-- TAB: Configuración FLEXIRENT -->
                        <page string="Configuración FLEXIRENT" 
                              invisible="pricing_type != 'flexirent'">
                            <group>
                                <group>
                                    <field name="flexirent_km_total" required="pricing_type == 'flexirent'"/>
                                    <field name="flexirent_duration_days"/>
                                    <field name="extra_km_price"/>
                                </group>
                                <group>
                                    <label for="price_per_unit" string="Precio Total Paquete"/>
                                    <div class="o_row">
                                        <field name="price_per_unit" required="1"/>
                                        <span> (IVA inc.) = </span>
                                        <field name="price_without_vat" readonly="1"/>
                                        <span> (sin IVA)</span>
                                    </div>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                            </group>
                            
                            <div class="alert alert-warning" role="alert">
                                <i class="fa fa-exclamation-triangle"/> 
                                <strong>FLEXIRENT:</strong> Paquete de larga temporada. 
                                El precio es <strong>total del paquete</strong>, no por día.
                                Los km adicionales se cobran a <field name="extra_km_price" readonly="1" class="oe_inline"/> € + IVA por km.
                            </div>
                        </page>

                        <!-- TAB: Notas -->
                        <page string="Notas y Condiciones">
                            <field name="notes" placeholder="Condiciones especiales, restricciones, observaciones..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Search (Búsqueda y Filtros) -->
    <record id="view_vehicle_pricing_rule_search" model="ir.ui.view">
        <field name="name">vehicle.pricing.rule.search</field>
        <field name="model">vehicle.pricing.rule</field>
        <field name="arch" type="xml">
            <search string="Buscar Tarifas">
                <!-- Campos de búsqueda -->
                <field name="name"/>
                <field name="vehicle_category_id"/>
                <field name="price_per_unit"/>
                
                <!-- Filtros predefinidos -->
                <filter name="active" string="Activas" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Inactivas" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="standard" string="Tarifas Estándar" domain="[('pricing_type', '=', 'standard')]"/>
                <filter name="flexirent" string="FLEXIRENT" domain="[('pricing_type', '=', 'flexirent')]"/>
                <separator/>
                <filter name="valid_today" string="Vigentes Hoy" 
                        domain="[('valid_from', '&lt;=', context_today().strftime('%Y-%m-%d')),
                                '|', ('valid_until', '=', False), 
                                    ('valid_until', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                
            </search>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="action_vehicle_pricing_rule" model="ir.actions.act_window">
        <field name="name">Tarifas de Vehículos</field>
        <field name="res_model">vehicle.pricing.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{
            'search_default_active': 1,
            'search_default_valid_today': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear primera tarifa de vehículo
            </p>
            <p>
                Las tarifas definen los precios de alquiler según la categoría del vehículo,
                kilómetros incluidos y duración del alquiler.
            </p>
            <p>
                <strong>Tarifas Estándar:</strong> Precio por día según km y duración<br/>
                <strong>FLEXIRENT:</strong> Paquetes de larga temporada (30 días)
            </p>
        </field>
    </record>

</odoo>

