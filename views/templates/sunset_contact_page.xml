<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sunset_contact_page" name="Sunset Contact Page">
        <t t-call="website.layout">
            <t t-set="title">Contacta con Nosotros - Sunset Rent a Car</t>
            
            <!-- Hero Section -->
            <div class="hero-section" style="background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%); padding: 80px 0; text-align: center;">
                <div class="container">
                    <h1 class="display-4 text-dark fw-bold mb-3">
                        <i class="fa fa-envelope me-3"></i>
                        Contacta con Nosotros
                    </h1>
                    <p class="lead text-dark mb-0">
                        Estamos aquí para ayudarte. Envíanos tu consulta y te responderemos lo antes posible.
                    </p>
                </div>
            </div>

            <!-- Main Content -->
            <div class="container my-5">
                <!-- Error Message -->
                <t t-if="error">
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fa fa-exclamation-triangle me-2"></i>
                        <span t-esc="error"/>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                </t>

                <div class="row">
                    <!-- Contact Form -->
                    <div class="col-lg-8 mb-5">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-dark text-white">
                                <h3 class="card-title mb-0">
                                    <i class="fa fa-paper-plane me-2"></i>
                                    Envíanos un Mensaje
                                </h3>
                            </div>
                            <div class="card-body p-4">
                                <form action="/sunset/contacto/enviar" method="post" class="needs-validation" novalidate="novalidate">
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="name" class="form-label text-dark fw-bold">
                                                <i class="fa fa-user me-1"></i>
                                                Nombre Completo *
                                            </label>
                                            <input type="text" 
                                                   class="form-control" 
                                                   id="name" 
                                                   name="name" 
                                                   required="required"
                                                   t-att-value="form_data.get('name', '')"
                                                   placeholder="Tu nombre completo"/>
                                            <div class="invalid-feedback">
                                                Por favor, introduce tu nombre.
                                            </div>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="email" class="form-label text-dark fw-bold">
                                                <i class="fa fa-envelope me-1"></i>
                                                Email *
                                            </label>
                                            <input type="email" 
                                                   class="form-control" 
                                                   id="email" 
                                                   name="email" 
                                                   required="required"
                                                   t-att-value="form_data.get('email', '')"
                                                   placeholder="tu@email.com"/>
                                            <div class="invalid-feedback">
                                                Por favor, introduce un email válido.
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="phone" class="form-label text-dark fw-bold">
                                                <i class="fa fa-phone me-1"></i>
                                                Teléfono
                                            </label>
                                            <input type="tel" 
                                                   class="form-control" 
                                                   id="phone" 
                                                   name="phone"
                                                   t-att-value="form_data.get('phone', '')"
                                                   placeholder="+34 600 123 456"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="subject" class="form-label text-dark fw-bold">
                                                <i class="fa fa-tag me-1"></i>
                                                Asunto *
                                            </label>
                                            <select class="form-select" id="subject" name="subject" required="required">
                                                <option value="">Selecciona un asunto</option>
                                                <option value="Consulta General" t-att-selected="form_data.get('subject') == 'Consulta General'">Consulta General</option>
                                                <option value="Reserva de Vehículo" t-att-selected="form_data.get('subject') == 'Reserva de Vehículo'">Reserva de Vehículo</option>
                                                <option value="Soporte Técnico" t-att-selected="form_data.get('subject') == 'Soporte Técnico'">Soporte Técnico</option>
                                                <option value="Facturación" t-att-selected="form_data.get('subject') == 'Facturación'">Facturación</option>
                                                <option value="Quejas y Sugerencias" t-att-selected="form_data.get('subject') == 'Quejas y Sugerencias'">Quejas y Sugerencias</option>
                                                <option value="Otro" t-att-selected="form_data.get('subject') == 'Otro'">Otro</option>
                                            </select>
                                            <div class="invalid-feedback">
                                                Por favor, selecciona un asunto.
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label for="message" class="form-label text-dark fw-bold">
                                            <i class="fa fa-comment me-1"></i>
                                            Mensaje *
                                        </label>
                                        <textarea class="form-control" 
                                                  id="message" 
                                                  name="message" 
                                                  rows="6" 
                                                  required="required"
                                                  placeholder="Escribe tu mensaje aquí..."><t t-esc="form_data.get('message', '')"/></textarea>
                                        <div class="invalid-feedback">
                                            Por favor, escribe tu mensaje.
                                        </div>
                                    </div>
                                    
                                    <div class="d-grid">
                                        <button type="submit" class="btn btn-dark btn-lg">
                                            <i class="fa fa-paper-plane me-2"></i>
                                            Enviar Mensaje
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Contact Information -->
                    <div class="col-lg-4">
                        <!-- Company Info -->
                        <div class="card shadow-sm border-0 mb-4">
                            <div class="card-header bg-info text-dark">
                                <h4 class="card-title mb-0">
                                    <i class="fa fa-building me-2"></i>
                                    <span t-esc="contact_info['company_name']"/>
                                </h4>
                            </div>
                            <div class="card-body">
                                <div class="contact-item mb-3">
                                    <div class="d-flex align-items-start">
                                        <i class="fa fa-map-marker-alt text-dark me-3 mt-1"></i>
                                        <div>
                                            <h6 class="text-dark fw-bold mb-1">Dirección</h6>
                                            <p class="text-muted mb-0" t-esc="contact_info['address']"/>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="contact-item mb-3">
                                    <div class="d-flex align-items-start">
                                        <i class="fa fa-phone text-dark me-3 mt-1"></i>
                                        <div>
                                            <h6 class="text-dark fw-bold mb-1">Teléfono</h6>
                                            <p class="text-muted mb-0" t-esc="contact_info['phone']"/>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="contact-item mb-3">
                                    <div class="d-flex align-items-start">
                                        <i class="fa fa-envelope text-dark me-3 mt-1"></i>
                                        <div>
                                            <h6 class="text-dark fw-bold mb-1">Email</h6>
                                            <p class="text-muted mb-0" t-esc="contact_info['email']"/>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="contact-item">
                                    <div class="d-flex align-items-start">
                                        <i class="fa fa-clock text-dark me-3 mt-1"></i>
                                        <div>
                                            <h6 class="text-dark fw-bold mb-1">Horarios</h6>
                                            <p class="text-muted mb-0" t-esc="contact_info['hours']"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Social Media -->
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-dark text-white">
                                <h5 class="card-title mb-0">
                                    <i class="fa fa-share-alt me-2"></i>
                                    Síguenos
                                </h5>
                            </div>
                            <div class="card-body text-center">
                                <div class="row">
                                    <div class="col-6 mb-3">
                                        <a href="#" class="btn btn-outline-primary btn-sm w-100">
                                            <i class="fab fa-facebook-f me-1"></i>
                                            Facebook
                                        </a>
                                    </div>
                                    <div class="col-6 mb-3">
                                        <a href="#" class="btn btn-outline-danger btn-sm w-100">
                                            <i class="fab fa-instagram me-1"></i>
                                            Instagram
                                        </a>
                                    </div>
                                    <div class="col-6 mb-3">
                                        <a href="#" class="btn btn-outline-info btn-sm w-100">
                                            <i class="fab fa-twitter me-1"></i>
                                            Twitter
                                        </a>
                                    </div>
                                    <div class="col-6 mb-3">
                                        <a href="#" class="btn btn-outline-primary btn-sm w-100">
                                            <i class="fab fa-linkedin-in me-1"></i>
                                            LinkedIn
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Delegations Section -->
                <div class="row mt-5">
                    <div class="col-12">
                        <h2 class="text-dark fw-bold text-center mb-4">
                            <i class="fa fa-map-marker-alt me-2"></i>
                            Nuestras Delegaciones
                        </h2>
                        <div class="row">
                            <t t-foreach="delegations" t-as="delegation">
                                <div class="col-lg-4 col-md-6 mb-4">
                                    <div class="card shadow-sm border-0 h-100">
                                        <div class="card-body text-center">
                                            <i class="fa fa-building fa-3x text-dark mb-3"></i>
                                            <h5 class="card-title text-dark fw-bold" t-esc="delegation['name']"/>
                                            <p class="text-muted mb-2">
                                                <i class="fa fa-map-marker-alt me-1"></i>
                                                <span t-esc="delegation['address']"/>
                                            </p>
                                            <p class="text-muted mb-2">
                                                <i class="fa fa-phone me-1"></i>
                                                <span t-esc="delegation['phone']"/>
                                            </p>
                                            <p class="text-muted mb-3">
                                                <i class="fa fa-envelope me-1"></i>
                                                <span t-esc="delegation['email']"/>
                                            </p>
                                            <a href="#" class="btn btn-outline-dark btn-sm">
                                                <i class="fa fa-directions me-1"></i>
                                                Cómo Llegar
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Custom CSS -->
            <style>
                .hero-section {
                    background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%) !important;
                }
                
                .btn-dark {
                    background: #000000 !important;
                    border: none !important;
                    color: #ffffff !important;
                }
                
                .btn-dark:hover {
                    background: #333333 !important;
                    transform: translateY(-1px);
                    color: #ffffff !important;
                }
                
                .bg-info {
                    background: #E6E6FA !important;
                    color: #000000 !important;
                }
                
                .text-dark {
                    color: #000000 !important;
                }
                
                .card {
                    border-radius: 10px !important;
                }
                
                .contact-item {
                    border-bottom: 1px solid #f0f0f0;
                    padding-bottom: 1rem;
                }
                
                .contact-item:last-child {
                    border-bottom: none;
                    padding-bottom: 0;
                }
                
                .form-control:focus,
                .form-select:focus {
                    border-color: #FFD700 !important;
                    box-shadow: 0 0 0 0.2rem rgba(255, 215, 0, 0.25) !important;
                }
            </style>

            <!-- JavaScript for Form Validation -->
            <script>
                (function() {
                    'use strict';
                    window.addEventListener('load', function() {
                        var forms = document.getElementsByClassName('needs-validation');
                        var validation = Array.prototype.filter.call(forms, function(form) {
                            form.addEventListener('submit', function(event) {
                                if (form.checkValidity() === false) {
                                    event.preventDefault();
                                    event.stopPropagation();
                                }
                                form.classList.add('was-validated');
                            }, false);
                        });
                    }, false);
                })();
            </script>
        </t>
    </template>
</odoo>
