<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sunset_services_page" name="Sunset Services Page">
        <t t-call="website.layout">
            <t t-set="title">Servicios - Sunset Rent a Car</t>
            
            <!-- Hero Section - EDITABLE -->
            <section class="hero-section o_editable" style="background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%); padding: 80px 0; text-align: center;">
                <div class="container">
                    <h1 class="display-4 fw-bold text-dark mb-4">Nuestros Servicios</h1>
                    <p class="lead text-dark">Soluciones completas de transporte para todas tus necesidades</p>
                </div>
            </section>
            
            <!-- Servicios Principales - EDITABLE -->
            <section class="container py-5 o_editable">
                <div class="row">
                    <div class="col-12 text-center mb-5">
                        <h2 class="h1 fw-bold text-dark">Servicios Principales</h2>
                        <p class="lead text-muted">Ofrecemos una amplia gama de servicios de transporte</p>
                    </div>
                </div>
                
                <div class="row g-4">
                    <div class="col-lg-4 col-md-6">
                        <div class="card h-100 shadow-sm border-0 o_editable" style="transition: transform 0.3s ease;">
                            <div class="card-body text-center p-4">
                                <div class="mb-4">
                                    <i class="fa fa-truck fa-4x text-dark"></i>
                                </div>
                                <h4 class="card-title fw-bold text-dark mb-3">Transporte de Carga</h4>
                                <p class="card-text text-muted mb-4">Soluciones eficientes para el transporte de mercancías</p>
                                
                                <ul class="list-unstyled text-start">
                                    <li class="mb-2">
                                        <i class="fa fa-check text-dark me-2"></i>
                                        Furgonetas de diferentes capacidades
                                    </li>
                                    <li class="mb-2">
                                        <i class="fa fa-check text-dark me-2"></i>
                                        Seguros completos incluidos
                                    </li>
                                    <li class="mb-2">
                                        <i class="fa fa-check text-dark me-2"></i>
                                        Disponibilidad 24/7
                                    </li>
                                </ul>
                                
                                <div class="mt-4">
                                    <a href="/web/booking-enquiry" class="btn btn-dark btn-lg px-4">
                                        <i class="fa fa-calendar me-2"></i>
                                        Reservar Ahora
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-lg-4 col-md-6">
                        <div class="card h-100 shadow-sm border-0 o_editable" style="transition: transform 0.3s ease;">
                            <div class="card-body text-center p-4">
                                <div class="mb-4">
                                    <i class="fa fa-users fa-4x text-dark"></i>
                                </div>
                                <h4 class="card-title fw-bold text-dark mb-3">Transporte de Pasajeros</h4>
                                <p class="card-text text-muted mb-4">Confort y seguridad para tus viajes en grupo</p>
                                
                                <ul class="list-unstyled text-start">
                                    <li class="mb-2">
                                        <i class="fa fa-check text-dark me-2"></i>
                                        Hasta 9 plazas de capacidad
                                    </li>
                                    <li class="mb-2">
                                        <i class="fa fa-check text-dark me-2"></i>
                                        Confort y climatización
                                    </li>
                                    <li class="mb-2">
                                        <i class="fa fa-check text-dark me-2"></i>
                                        Conductores profesionales
                                    </li>
                                </ul>
                                
                                <div class="mt-4">
                                    <a href="/web/booking-enquiry" class="btn btn-dark btn-lg px-4">
                                        <i class="fa fa-calendar me-2"></i>
                                        Reservar Ahora
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-lg-4 col-md-6">
                        <div class="card h-100 shadow-sm border-0 o_editable" style="transition: transform 0.3s ease;">
                            <div class="card-body text-center p-4">
                                <div class="mb-4">
                                    <i class="fa fa-briefcase fa-4x text-dark"></i>
                                </div>
                                <h4 class="card-title fw-bold text-dark mb-3">Soluciones Empresariales</h4>
                                <p class="card-text text-muted mb-4">Flota dedicada para tu empresa</p>
                                
                                <ul class="list-unstyled text-start">
                                    <li class="mb-2">
                                        <i class="fa fa-check text-dark me-2"></i>
                                        Contratos personalizados
                                    </li>
                                    <li class="mb-2">
                                        <i class="fa fa-check text-dark me-2"></i>
                                        Mantenimiento incluido
                                    </li>
                                    <li class="mb-2">
                                        <i class="fa fa-check text-dark me-2"></i>
                                        Gestión centralizada
                                    </li>
                                </ul>
                                
                                <div class="mt-4">
                                    <a href="/web/booking-enquiry" class="btn btn-dark btn-lg px-4">
                                        <i class="fa fa-calendar me-2"></i>
                                        Reservar Ahora
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            
            <!-- CTA Final - EDITABLE -->
            <section class="cta-section py-5 o_editable" style="background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);">
                <div class="container text-center">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <h2 class="display-5 fw-bold text-dark mb-4">
                                <i class="fa fa-rocket me-3"></i>
                                ¿Necesitas más información?
                            </h2>
                            <p class="lead text-dark mb-4">
                                Contáctanos para conocer más detalles sobre nuestros servicios
                            </p>
                            <div class="cta-buttons">
                                <a href="/sunset/contacto" class="btn btn-dark btn-lg me-3">
                                    <i class="fa fa-envelope me-2"></i>
                                    Contáctanos
                                </a>
                                <a href="/web/booking-enquiry" class="btn btn-outline-dark btn-lg">
                                    <i class="fa fa-calendar me-2"></i>
                                    Reservar
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <style>
                .hero-section {
                    position: relative;
                }
                
                .card:hover {
                    transform: translateY(-10px);
                    box-shadow: 0 15px 35px rgba(0,0,0,0.1);
                }
                
                .btn-dark {
                    background: #000000;
                    border: none;
                    color: #ffffff;
                }
                
                .btn-dark:hover {
                    background: #333333;
                    color: #ffffff;
                }
            </style>
        </t>
    </template>
</odoo>
