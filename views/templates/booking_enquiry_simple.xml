<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Simple Booking Enquiry Template -->
<template id="booking_enquiry_simple" name="Simple Booking Enquiry">
    <t t-call="website.layout">
        <div class="container py-4">
            <h2 class="mb-4 text-center text-dark">
                <i class="fa fa-car me-2"></i>
                Selecciona tu Categoría de Vehículo
            </h2>
            <p class="text-center text-muted mb-4">
                Elige la categoría que mejor se adapte a tus necesidades
            </p>
            
            <div class="row g-4">
                <t t-foreach="vehicle_categories" t-as="category">
                    <div class="col-lg-4 col-md-6 col-12">
                        <div class="card h-100 category-card" 
                             style="cursor: pointer; transition: all 0.3s ease;"
                             t-att-onclick="'selectCategory(' + str(category.id) + ')'">
                            <div class="card-img-top d-flex align-items-center justify-content-center" 
                                 t-attf-style="height: 200px; background: linear-gradient(135deg, #{primary_color} 0%, #{secondary_color} 100%);">
                                <img t-att-src="'/vehicle_rental/static/description/img/tipos/tipoA.png'"
                                     t-att-alt="category.name"
                                     style="max-height: 150px; max-width: 200px; object-fit: contain;" 
                                     loading="lazy"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                                     t-if="'Tipo A' in category.name"/>
                                <img t-att-src="'/vehicle_rental/static/description/img/tipos/tipoB.png'"
                                     t-att-alt="category.name"
                                     style="max-height: 150px; max-width: 200px; object-fit: contain;" 
                                     loading="lazy"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                                     t-if="'Tipo B' in category.name"/>
                                <img t-att-src="'/vehicle_rental/static/description/img/tipos/tipoC.png'"
                                     t-att-alt="category.name"
                                     style="max-height: 150px; max-width: 200px; object-fit: contain;" 
                                     loading="lazy"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                                     t-if="'Tipo C' in category.name"/>
                                <img t-att-src="'/vehicle_rental/static/description/img/tipos/tipoD.png'"
                                     t-att-alt="category.name"
                                     style="max-height: 150px; max-width: 200px; object-fit: contain;" 
                                     loading="lazy"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                                     t-if="'Tipo D' in category.name"/>
                                <img t-att-src="'/vehicle_rental/static/description/img/tipos/tipoE.png'"
                                     t-att-alt="category.name"
                                     style="max-height: 150px; max-width: 200px; object-fit: contain;" 
                                     loading="lazy"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                                     t-if="'Tipo E' in category.name"/>
                                <img t-att-src="'/vehicle_rental/static/description/img/tipos/tipoF.png'"
                                     t-att-alt="category.name"
                                     style="max-height: 150px; max-width: 200px; object-fit: contain;" 
                                     loading="lazy"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                                     t-if="'Tipo F' in category.name"/>
                                <img t-att-src="'/vehicle_rental/static/description/img/tipos/tipoK.png'"
                                     t-att-alt="category.name"
                                     style="max-height: 150px; max-width: 200px; object-fit: contain;" 
                                     loading="lazy"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                                     t-if="'Tipo K' in category.name"/>
                                <img t-att-src="'/vehicle_rental/static/description/img/tipos/tipoT.png'"
                                     t-att-alt="category.name"
                                     style="max-height: 150px; max-width: 200px; object-fit: contain;" 
                                     loading="lazy"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                                     t-if="'Tipo T' in category.name"/>
                                <img t-att-src="'/vehicle_rental/static/description/img/tipos/tipoV.png'"
                                     t-att-alt="category.name"
                                     style="max-height: 150px; max-width: 200px; object-fit: contain;" 
                                     loading="lazy"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                                     t-if="'Tipo V' in category.name"/>
                                <img t-att-src="'/vehicle_rental/static/description/img/tipos/tipoW.png'"
                                     t-att-alt="category.name"
                                     style="max-height: 150px; max-width: 200px; object-fit: contain;" 
                                     loading="lazy"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                                     t-if="'Tipo W' in category.name"/>
                                <img t-att-src="'/vehicle_rental/static/description/img/tipos/tipoX.png'"
                                     t-att-alt="category.name"
                                     style="max-height: 150px; max-width: 200px; object-fit: contain;" 
                                     loading="lazy"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                                     t-if="'Tipo X' in category.name"/>
                                <img t-att-src="'/vehicle_rental/static/description/img/tipos/tipoZ.png'"
                                     t-att-alt="category.name"
                                     style="max-height: 150px; max-width: 200px; object-fit: contain;" 
                                     loading="lazy"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                                     t-if="'Tipo Z' in category.name"/>
                                <i class="fa fa-car fa-4x text-white" style="display: none;"></i>
                            </div>
                            <div class="card-body text-center">
                                <h5 class="card-title" t-esc="category.name"/>
                                <p class="card-text text-muted">
                                    <t t-if="'Tipo A' in category.name">
                                        Furgonetas compactas ideales para la ciudad
                                    </t>
                                    <t t-elif="'Tipo B' in category.name">
                                        Furgonetas medianas para transporte urbano
                                    </t>
                                    <t t-elif="'Tipo C' in category.name">
                                        Furgonetas compactas para servicios urbanos
                                    </t>
                                    <t t-elif="'Tipo D' in category.name">
                                        Furgonetas grandes para carga pesada
                                    </t>
                                    <t t-elif="'Tipo E' in category.name">
                                        Furgonetas extra grandes para transporte
                                    </t>
                                    <t t-elif="'Tipo F' in category.name">
                                        Furgonetas especiales para servicios
                                    </t>
                                    <t t-elif="'Tipo K' in category.name">
                                        Furgonetas de lujo para eventos
                                    </t>
                                    <t t-else="">
                                        Categoría de vehículo disponible
                                    </t>
                                </p>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </div>

        <script>
            function selectCategory(categoryId) {
                window.location.href = '/web/vehicle-detail/' + categoryId;
            }
        </script>
    </t>
</template>
</odoo>
