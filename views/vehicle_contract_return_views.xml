<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================ -->
    <!-- Vehicle Contract Return Views -->
    <!-- ============================================ -->

    <!-- List View -->
    <record id="vehicle_contract_return_tree_view" model="ir.ui.view">
        <field name="name">vehicle.contract.return.tree</field>
        <field name="model">vehicle.contract.return</field>
        <field name="arch" type="xml">
            <list string="Devoluciones de Vehículos" create="false"
                  decoration-danger="has_damage">
                <field name="return_date"/>
                <field name="contract_id"/>
                <field name="vehicle_id"/>
                <field name="odometer"/>
                <field name="km_driven"/>
                <field name="fuel_level"/>
                <field name="has_damage"/>
                <field name="damage_amount"/>
                <field name="acta_generated"/>
                <field name="responsible_id"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="vehicle_contract_return_form_view" model="ir.ui.view">
        <field name="name">vehicle.contract.return.form</field>
        <field name="model">vehicle.contract.return</field>
        <field name="arch" type="xml">
            <form string="Devolución de Vehículo" create="false">
                <header>
                    <button name="action_generate_acta"
                            string="Generar Acta"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_create_damage_invoice"
                            string="Facturar Daños"
                            type="object"
                            class="btn-secondary"
                            invisible="not has_damage or damage_amount == 0 or damage_invoice_id"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_damage_invoice"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                string="Factura de Daños"
                                invisible="not damage_invoice_id"/>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Información General">
                            <field name="contract_id"/>
                            <field name="vehicle_id"/>
                            <field name="return_date"/>
                            <field name="responsible_id"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="odometer_unit" invisible="1"/>
                            <field name="damage_invoice_id" invisible="1"/>
                        </group>
                        <group string="Documentación">
                            <field name="acta_generated"/>
                            <field name="acta_pdf" filename="acta_filename" invisible="not acta_generated"/>
                            <field name="acta_filename" invisible="1"/>
                            <field name="signature_date"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Estado del Vehículo" name="vehicle_state">
                            <group>
                                <group string="Kilometraje">
                                    <field name="odometer_start"/>
                                    <field name="odometer"/>
                                    <field name="km_driven"/>
                                </group>
                                <group string="Combustible">
                                    <field name="fuel_level_start"/>
                                    <field name="fuel_level"/>
                                </group>
                            </group>
                        </page>

                        <page string="Inspección de Daños" name="damages">
                            <group>
                                <group>
                                    <field name="inspection_done"/>
                                    <field name="has_damage"/>
                                </group>
                                <group invisible="not has_damage">
                                    <field name="damage_amount"/>
                                    <field name="damage_invoice_id" readonly="1"/>
                                </group>
                            </group>
                            <field name="damage_description" invisible="not has_damage"/>
                            <group string="Imagen de Daños" invisible="not painted_damage_image">
                                <field name="painted_damage_image"
                                       widget="image"
                                       options="{'size': [800, 600]}"
                                       nolabel="1"/>
                            </group>
                            <field name="damage_image_ids"
                                   widget="many2many_binary"
                                   string="Fotos de Daños"
                                   invisible="not has_damage"/>
                        </page>

                        <page string="Firmas" name="signatures">
                            <group>
                                <group string="Firma del Cliente">
                                    <field name="customer_signature" widget="image" nolabel="1"/>
                                </group>
                                <group string="Firma de la Empresa">
                                    <field name="company_signature" widget="image" nolabel="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Notas Adicionales" name="notes">
                            <field name="notes" placeholder="Notas adicionales sobre la devolución..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="vehicle_contract_return_search_view" model="ir.ui.view">
        <field name="name">vehicle.contract.return.search</field>
        <field name="model">vehicle.contract.return</field>
        <field name="arch" type="xml">
            <search string="Buscar Devoluciones">
                <field name="contract_id"/>
                <field name="vehicle_id"/>
                <field name="responsible_id"/>
                <separator/>
                <filter string="Con Daños" name="with_damage" domain="[('has_damage', '=', True)]"/>
                <filter string="Sin Daños" name="without_damage" domain="[('has_damage', '=', False)]"/>
                <filter string="Acta Generada" name="acta_done" domain="[('acta_generated', '=', True)]"/>
                <separator/>
                <filter string="Con Firma del Cliente" name="signed"
                        domain="[('customer_signature', '!=', False)]"/>
                <separator/>
                <filter string="Contrato" name="group_contract" context="{'group_by': 'contract_id'}"/>
                <filter string="Vehículo" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                <filter string="Mes de Devolución" name="group_date"
                        context="{'group_by': 'return_date:month'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_vehicle_contract_return" model="ir.actions.act_window">
        <field name="name">Devoluciones de Vehículos</field>
        <field name="res_model">vehicle.contract.return</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay devoluciones registradas
            </p>
            <p>
                Las devoluciones se registran desde el contrato con el botón "Return".
            </p>
        </field>
    </record>

    <!-- Heredar vista contrato: stat button + tab de devoluciones -->
    <record id="vehicle_contract_form_view_return_inherit" model="ir.ui.view">
        <field name="name">vehicle.contract.form.view.return.inherit</field>
        <field name="model">vehicle.contract</field>
        <field name="inherit_id" ref="vehicle_rental.vehicle_contract_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_substitutions']" position="after">
                <button class="oe_stat_button" type="object" name="action_view_returns"
                        icon="fa-sign-in" invisible="return_count == 0">
                    <field string="Devoluciones" name="return_count" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='is_scratch_report']" position="before">
                <field name="initial_fuel_level" readonly="status in ['c_return', 'd_cancel']"/>
            </xpath>
            <xpath expr="//page[@name='damage']" position="after">
                <page name="contract_returns" string="Devoluciones" invisible="return_count == 0">
                    <field name="return_ids" nolabel="1" readonly="1">
                        <list create="0" delete="0" edit="0" decoration-danger="has_damage">
                            <field name="return_date"/>
                            <field name="vehicle_id"/>
                            <field name="odometer"/>
                            <field name="km_driven"/>
                            <field name="fuel_level"/>
                            <field name="has_damage" widget="boolean_toggle"/>
                            <field name="damage_amount" widget="monetary"/>
                            <field name="acta_generated" widget="boolean_toggle"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
