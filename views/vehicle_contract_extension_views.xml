<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action (primero para que el menú lo encuentre) -->
    <record id="action_vehicle_contract_extension" model="ir.actions.act_window">
        <field name="name">Ampliaciones de contrato</field>
        <field name="res_model">vehicle.contract.extension</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crear una ampliación</p>
            <p>Las ampliaciones se crean desde el contrato (botón "Ampliar contrato"). Aquí puede ver y gestionar todas las ampliaciones.</p>
        </field>
    </record>

    <!-- Tree -->
    <record id="vehicle_contract_extension_view_tree" model="ir.ui.view">
        <field name="name">vehicle.contract.extension.tree</field>
        <field name="model">vehicle.contract.extension</field>
        <field name="arch" type="xml">
            <list string="Ampliaciones" decoration-muted="state == 'cancelled'" decoration-success="state == 'invoiced'">
                <field name="contract_id"/>
                <field name="original_end_date"/>
                <field name="new_end_date"/>
                <field name="extension_days"/>
                <field name="daily_rate"/>
                <field name="extension_amount"/>
                <field name="state"/>
                <field name="extension_invoice_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="vehicle_contract_extension_view_form" model="ir.ui.view">
        <field name="name">vehicle.contract.extension.form</field>
        <field name="model">vehicle.contract.extension</field>
        <field name="arch" type="xml">
            <form string="Ampliación de contrato">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_create_extension_invoice" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="state != 'signed' or extension_invoice_id"
                                string="Crear factura"/>
                        <button name="action_view_extension_invoice" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not extension_invoice_id"/>
                    </div>
                    <widget name="web_ribbon" title="Cancelado" bg_color="text-bg-danger" invisible="state != 'cancelled'"/>
                    <group>
                        <group string="Contrato y fechas">
                            <field name="contract_id" options="{'no_create': True}"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="original_end_date" readonly="1"/>
                            <field name="new_end_date"/>
                            <field name="extension_days" readonly="1"/>
                        </group>
                        <group string="Tarifa e importe">
                            <field name="daily_rate"/>
                            <field name="extension_amount" readonly="1"/>
                            <field name="state"/>
                            <field name="extension_invoice_id" readonly="1" invisible="state != 'invoiced'"/>
                        </group>
                    </group>
                    <group invisible="state == 'draft'">
                        <group string="Flujo">
                            <field name="extension_invoice_state" invisible="not extension_invoice_id"/>
                        </group>
                    </group>
                    <div class="mt-3">
                        <button name="action_send_to_sign" type="object" string="Enviar a firmar" class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button name="action_mark_sent" type="object" string="Marcar como enviado"
                                invisible="state != 'draft'"/>
                        <button name="action_mark_signed" type="object" string="Marcar como firmado"
                                invisible="state not in ('draft', 'sent')"/>
                        <button name="action_cancel" type="object" string="Cancelar" class="btn-outline-danger"
                                invisible="state in ('invoiced', 'cancelled')"/>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Heredar vista contrato: botón Ampliar + stat Ampliaciones (se valida cuando este módulo ya cargó) -->
    <record id="vehicle_contract_form_view_extension_button" model="ir.ui.view">
        <field name="name">vehicle.contract.form.view.extension.button</field>
        <field name="model">vehicle.contract</field>
        <field name="inherit_id" ref="vehicle_rental.vehicle_contract_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_print_contract']" position="before">
                <button string="Ampliar contrato" name="action_new_extension" type="object"
                        class="btn btn-info" icon="fa-calendar-plus-o"
                        invisible="status in ('c_return', 'd_cancel')"/>
            </xpath>
            <xpath expr="//button[@name='action_view_substitutions']" position="after">
                <button class="oe_stat_button" type="object" name="action_view_extensions"
                        icon="fa-calendar-plus-o" invisible="extension_count == 0">
                    <field string="Ampliaciones" name="extension_count" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='damage']" position="after">
                <page name="contract_extensions" string="Ampliaciones">
                    <field name="extension_ids" nolabel="1" readonly="1">
                        <list create="1" delete="0" edit="0" decoration-muted="state == 'cancelled'">
                            <field name="original_end_date"/>
                            <field name="new_end_date"/>
                            <field name="extension_days"/>
                            <field name="extension_amount" widget="monetary"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'invoiced'"
                                   decoration-info="state == 'signed'"
                                   decoration-warning="state in ('sent', 'draft')"
                                   decoration-danger="state == 'cancelled'"/>
                            <field name="extension_invoice_id" optional="show"/>
                            <button name="action_create_extension_invoice" type="object" string="Facturar"
                                    icon="fa-file-text-o" invisible="state != 'signed' or extension_invoice_id"/>
                            <button name="action_view_extension_invoice" type="object" string="Ver factura"
                                    icon="fa-external-link" invisible="not extension_invoice_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
