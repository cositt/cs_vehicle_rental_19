<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="redsys_checkout" name="Redsys Checkout">
        <t t-name="vehicle_rental.redsys_checkout">
            <html>
                <head>
                    <meta charset="utf-8"/>
                    <meta name="viewport" content="width=device-width, initial-scale=1"/>
                    <title>Procesando pago...</title>
                    <style>
                        body { font-family: Arial; display: flex; justify-content: center; align-items: center; height: 100vh; background: #667eea; }
                        .container { background: white; padding: 40px; border-radius: 8px; text-align: center; }
                        .spinner { border: 4px solid #f3f3f3; border-top: 4px solid #667eea; border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; margin: 20px auto; }
                        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
                    </style>
                </head>
                <body>
                    <div class="container">
                        <h2>Procesando tu pago...</h2>
                        <div class="spinner"></div>
                        <p>Serás redirigido a Redsys en unos momentos.</p>
                        <form id="form" method="POST" action="https://sis-t.redsys.es:25443/sis/realizarPago">
                            <input type="hidden" name="Ds_SignVersion" value="HMAC_SHA256_V1"/>
                            <input type="hidden" name="Ds_MerchantParameters" t-att-value="merchant_params"/>
                            <input type="hidden" name="Ds_Signature" t-att-value="signature"/>
                        </form>
                        <script>document.getElementById('form').submit();</script>
                    </div>
                </body>
            </html>
        </t>
    </template>
</odoo>
