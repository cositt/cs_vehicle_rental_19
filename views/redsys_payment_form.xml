<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="redsys_payment_form" name="Redsys Payment Form - Hidden Form">
        <t t-name="vehicle_rental.redsys_payment_form">
            <html>
                <head>
                    <meta charset="utf-8"/>
                    <meta name="viewport" content="width=device-width, initial-scale=1"/>
                    <title>Procesando pago...</title>
                    <style>
                        body {
                            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
                            display: flex;
                            justify-content: center;
                            align-items: center;
                            height: 100vh;
                            margin: 0;
                            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                        }
                        .container {
                            background: white;
                            padding: 40px;
                            border-radius: 8px;
                            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
                            text-align: center;
                            max-width: 500px;
                        }
                        .spinner {
                            border: 4px solid #f3f3f3;
                            border-top: 4px solid #667eea;
                            border-radius: 50%;
                            width: 40px;
                            height: 40px;
                            animation: spin 1s linear infinite;
                            margin: 20px auto;
                        }
                        @keyframes spin {
                            0% { transform: rotate(0deg); }
                            100% { transform: rotate(360deg); }
                        }
                        h2 {
                            color: #333;
                            margin-top: 0;
                        }
                        p {
                            color: #666;
                            margin: 15px 0;
                        }
                        .info {
                            background: #f5f5f5;
                            padding: 15px;
                            border-radius: 4px;
                            margin: 20px 0;
                            text-align: left;
                            font-size: 14px;
                        }
                        .info strong {
                            display: block;
                            color: #333;
                            margin-bottom: 5px;
                        }
                        .info span {
                            display: block;
                            color: #666;
                            margin: 3px 0;
                        }
                        .button-container {
                            margin-top: 30px;
                        }
                        button {
                            background: #667eea;
                            color: white;
                            border: none;
                            padding: 12px 30px;
                            border-radius: 4px;
                            cursor: pointer;
                            font-size: 16px;
                            font-weight: 600;
                            transition: background 0.3s;
                            display: none;
                        }
                        button:hover {
                            background: #764ba2;
                        }
                        #redsys_form {
                            display: none;
                        }
                        .error-message {
                            color: #d32f2f;
                            display: none;
                            margin-top: 20px;
                            padding: 15px;
                            background: #ffebee;
                            border-radius: 4px;
                            border-left: 4px solid #d32f2f;
                        }
                    </style>
                </head>
                <body>
                    <div class="container">
                        <h2>Procesando tu pago...</h2>
                        <div class="spinner"></div>
                        <p>Serás redirigido a Redsys en unos momentos.</p>
                        <p style="font-size: 12px; color: #999;">Por favor no cierres esta página.</p>

                        <div class="info">
                            <strong>Detalles de la reserva:</strong>
                            <span>
                                <strong>Monto:</strong>
                                <t t-if="amount">
                                    <t t-out="'%.2f EUR' % (amount,)"/>
                                </t>
                            </span>
                            <span>
                                <strong>Referencia:</strong>
                                <t t-out="reference"/>
                            </span>
                            <span>
                                <strong>Empresa:</strong>
                                <t t-if="partner_name" t-out="partner_name"/>
                                <t t-else="">Empresa</t>
                            </span>
                        </div>

                        <form id="redsys_form" method="POST" t-att-action="action_url">
                            <t t-foreach="form_inputs" t-as="input">
                                <input t-att-type="input['type']" t-att-name="input['name']" t-att-value="input['value']" />
                            </t>
                        </form>

                        <div class="button-container">
                            <button id="submit_btn" type="button">
                                Ir a Redsys
                            </button>
                        </div>

                        <div id="error_message" class="error-message">
                            <strong>Error:</strong> No se pudo procesar tu pago. Por favor, recarga la página e intenta de nuevo.
                        </div>
                    </div>

                    <script type="text/javascript"><![CDATA[
                        (function() {
                            'use strict';

                            function submitForm() {
                                var form = document.getElementById('redsys_form');
                                if (form) {
                                    try {
                                        console.log('Enviando formulario a Redsys...');
                                        form.submit();
                                        setTimeout(function() {
                                            showError();
                                        }, 3000);
                                    } catch (e) {
                                        console.error('Error enviando formulario:', e);
                                        showError();
                                    }
                                } else {
                                    console.error('Formulario no encontrado');
                                    showError();
                                }
                            }

                            function showError() {
                                var errorMsg = document.getElementById('error_message');
                                var spinner = document.querySelector('.spinner');
                                var p = document.querySelector('p:first-of-type');
                                var submitBtn = document.getElementById('submit_btn');

                                if (spinner) spinner.style.display = 'none';
                                if (p) p.style.display = 'none';
                                if (submitBtn) submitBtn.style.display = 'inline-block';
                                if (errorMsg) errorMsg.style.display = 'block';
                            }

                            var submitBtn = document.getElementById('submit_btn');
                            if (submitBtn) {
                                submitBtn.addEventListener('click', submitForm);
                            }

                            if (document.readyState === 'loading') {
                                document.addEventListener('DOMContentLoaded', submitForm);
                            } else {
                                submitForm();
                            }

                            setTimeout(function() {
                                var form = document.getElementById('redsys_form');
                                if (form && form.parentElement) {
                                    console.warn('Timeout: formulario aun no enviado');
                                    showError();
                                }
                            }, 5000);
                        })();
                    ]]></script>
                </body>
            </html>
        </t>
    </template>
</odoo>
