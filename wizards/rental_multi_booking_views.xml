<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <!-- LIST VIEW -->
        <record id="rental_multi_booking_view_list" model="ir.ui.view">
            <field name="name">rental.multi.booking.list</field>
            <field name="model">rental.multi.booking</field>
            <field name="arch" type="xml">
                <list string="Reservas Múltiples"
                      decoration-muted="state == 'cancel'"
                      decoration-success="state == 'done'">
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="line_count" string="Vehículos"/>
                    <field name="payment_type"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'draft'"
                           decoration-success="state == 'done'"
                           decoration-danger="state == 'cancel'"/>
                    <field name="group_id" optional="show"/>
                    <field name="create_date" string="Fecha"/>
                </list>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="rental_multi_booking_form_view" model="ir.ui.view">
            <field name="name">rental.multi.booking.form</field>
            <field name="model">rental.multi.booking</field>
            <field name="arch" type="xml">
                <form string="Reserva Múltiple de Vehículos">
                    <header>
                        <button string="Añadir Vehículo" name="action_add_vehicle"
                                type="object" class="btn btn-primary" icon="fa-plus"
                                invisible="state != 'draft'"/>
                        <button string="Crear Reserva Múltiple" name="action_create_group"
                                type="object" class="btn btn-success" icon="fa-check"
                                invisible="state != 'draft' or line_count == 0"
                                confirm="Se crearán el contrato grupo y los contratos individuales. ¿Continuar?"/>
                        <button string="Cancelar" name="action_cancel"
                                type="object" class="btn btn-secondary"
                                invisible="state != 'draft'"
                                confirm="¿Cancelar esta reserva múltiple?"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,done"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="customer_id"
                                       readonly="state != 'draft'"
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="company_id" invisible="1"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="payment_type"
                                       readonly="state != 'draft'"/>
                                <field name="deposit_card_type"
                                       readonly="state != 'draft'"/>
                                <field name="group_id" readonly="1"
                                       invisible="not group_id"/>
                            </group>
                        </group>

                        <separator string="Vehículos seleccionados"/>
                        <field name="line_ids" nolabel="1" readonly="state != 'draft'">
                            <list create="0" edit="0" delete="1">
                                <field name="vehicle_id"/>
                                <field name="license_plate"/>
                                <field name="vehicle_category_id"/>
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="pricing_type"/>
                                <field name="rent" widget="monetary"/>
                                <field name="currency_id" column_invisible="1"/>
                                <field name="company_id" column_invisible="1"/>
                            </list>
                        </field>

                        <group>
                            <field name="notes" placeholder="Observaciones internas..."
                                   readonly="state != 'draft'"/>
                        </group>
                        <field name="line_count" invisible="1"/>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_rental_multi_booking" model="ir.actions.act_window">
            <field name="name">Reserva Múltiple</field>
            <field name="res_model">rental.multi.booking</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
