<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <!-- Wizard Form View -->
        <record id="sale_order_to_vehicle_contract_form_view" model="ir.ui.view">
            <field name="name">sale.order.to.vehicle.contract.form.view</field>
            <field name="model">sale.order.to.vehicle.contract</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="partner_id" required="1"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="vehicle_id" required="1"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="start_date" required="1"/>
                            <field name="end_date" required="1"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Crear Contrato de Vehículo" name="action_create_vehicle_contract" type="object"
                                class="oe_highlight"/>
                        <button string="Cancelar" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        
        <!-- Action -->
        <record id="action_sale_order_to_vehicle_contract" model="ir.actions.act_window">
            <field name="name">Crear Contrato de Vehículo</field>
            <field name="res_model">sale.order.to.vehicle.contract</field>
            <field name="target">new</field>
            <field name="view_id" ref="sale_order_to_vehicle_contract_form_view"/>
        </record>
    </data>
</odoo>

