<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================ -->
    <!-- Vehicle Substitution Wizard Views -->
    <!-- ============================================ -->

    <!-- Wizard Form View -->
    <record id="vehicle_substitution_wizard_form_view" model="ir.ui.view">
        <field name="name">vehicle.substitution.wizard.form</field>
        <field name="model">vehicle.substitution.wizard</field>
        <field name="arch" type="xml">
            <form string="Sustitución de Vehículo">
                <field name="step" invisible="1"/>
                <field name="contract_id" invisible="1"/>
                <field name="customer_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="old_vehicle_id" invisible="1"/>
                <field name="new_vehicle_id" invisible="1"/>
                <field name="has_price_difference" invisible="1"/>
                
                <group>
                    <group>
                        <field name="contract_id" readonly="1" force_save="1"/>
                        <field name="customer_id" readonly="1" force_save="1"/>
                    </group>
                    <group>
                        <field name="substitution_date"/>
                    </group>
                </group>
                
                <separator/>
                
                <!-- PASO 1: Inspección del Vehículo Actual -->
                <group invisible="step != '1_old_vehicle'">
                    <div class="alert alert-info" role="alert" col="2">
                        <h4><i class="fa fa-car"/> Paso 1 de 4: Inspección del Vehículo Actual</h4>
                        <p>Registre el estado del vehículo que se va a retirar del contrato.</p>
                    </div>
                    
                    <group string="Vehículo Actual" col="2">
                        <field name="old_vehicle_id" readonly="1" force_save="1"/>
                        <field name="old_vehicle_license_plate" readonly="1"/>
                    </group>
                    
                    <group string="Estado de Devolución" col="2">
                        <field name="old_vehicle_odometer" required="step == '1_old_vehicle'"/>
                        <field name="old_vehicle_fuel_level" widget="radio" required="step == '1_old_vehicle'"/>
                    </group>
                    
                    <group string="Daños" col="2">
                        <field name="old_vehicle_has_damage"/>
                    </group>
                    
                    <group string="Detalles de Daños" col="2" invisible="not old_vehicle_has_damage">
                        <field name="old_vehicle_damage_description" colspan="2" nolabel="1"/>
                        <field name="old_vehicle_damage_amount"/>
                        <button name="action_open_old_damage_painter" 
                                string="Pintar Daños" 
                                type="object" 
                                class="btn-secondary" 
                                icon="fa-paint-brush"/>
                        <field name="old_vehicle_painted_damage_image" 
                               widget="image" 
                               options="{'size': [400, 300]}"
                               colspan="2"
                               nolabel="1"
                               invisible="not old_vehicle_painted_damage_image"/>
                    </group>
                    
                    <!-- Botones de navegación Paso 1 -->
                    <group col="2" colspan="2">
                        <div/>
                        <div class="float-end">
                            <button string="Siguiente" 
                                    name="action_next_step" 
                                    type="object" 
                                    class="btn-primary"
                                    icon="fa-arrow-right"/>
                        </div>
                    </group>
                </group>
                
                <!-- PASO 2: Selección del Nuevo Vehículo -->
                <group invisible="step != '2_select_new'">
                    <div class="alert alert-info" role="alert" col="2">
                        <h4><i class="fa fa-search"/> Paso 2 de 4: Selección del Vehículo Sustituto</h4>
                        <p>Seleccione el vehículo que reemplazará al actual e indique el motivo de la sustitución.</p>
                    </div>
                    
                    <group string="Motivo de la Sustitución" col="2">
                        <field name="reason" widget="radio" required="step == '2_select_new'"/>
                        <field name="reason_notes" colspan="2" nolabel="1" placeholder="Detalles adicionales..."/>
                    </group>
                    
                    <group string="Vehículo Sustituto" col="2">
                        <field name="new_vehicle_id" 
                               required="step == '2_select_new'"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="new_vehicle_license_plate" readonly="1" invisible="not new_vehicle_id"/>
                        <field name="new_vehicle_category_id" readonly="1" invisible="not new_vehicle_id"/>
                    </group>
                    
                    <group string="Resumen Comparativo" col="2" invisible="not new_vehicle_id">
                        <label for="old_vehicle_id" string="Vehículo Actual"/>
                        <div>
                            <field name="old_vehicle_id" readonly="1" nolabel="1" class="oe_inline"/>
                            (<field name="old_vehicle_license_plate" readonly="1" nolabel="1" class="oe_inline"/>)
                        </div>
                        
                        <label for="new_vehicle_id" string="Vehículo Sustituto" class="text-success"/>
                        <div>
                            <field name="new_vehicle_id" readonly="1" nolabel="1" class="oe_inline text-success"/>
                            (<field name="new_vehicle_license_plate" readonly="1" nolabel="1" class="oe_inline"/>)
                        </div>
                    </group>
                    
                    <!-- Botones de navegación Paso 2 -->
                    <group col="2" colspan="2">
                        <div>
                            <button string="Anterior" 
                                    name="action_previous_step" 
                                    type="object" 
                                    class="btn-secondary"
                                    icon="fa-arrow-left"/>
                        </div>
                        <div class="float-end">
                            <button string="Siguiente" 
                                    name="action_next_step" 
                                    type="object" 
                                    class="btn-primary"
                                    icon="fa-arrow-right"/>
                        </div>
                    </group>
                </group>
                
                <!-- PASO 3: Inspección del Vehículo Sustituto -->
                <group invisible="step != '3_new_vehicle'">
                    <div class="alert alert-info" role="alert" col="2">
                        <h4><i class="fa fa-check-square-o"/> Paso 3 de 4: Inspección del Vehículo Sustituto</h4>
                        <p>Registre el estado del vehículo que se va a entregar al cliente.</p>
                    </div>
                    
                    <group string="Vehículo Sustituto" col="2">
                        <field name="new_vehicle_id" readonly="1" force_save="1"/>
                        <field name="new_vehicle_license_plate" readonly="1"/>
                    </group>
                    
                    <group string="Estado de Entrega" col="2">
                        <field name="new_vehicle_odometer" readonly="1"/>
                        <field name="new_vehicle_fuel_level" widget="radio" required="step == '3_new_vehicle'"/>
                    </group>
                    
                    <group string="Daños Previos" col="2">
                        <field name="new_vehicle_has_damage"/>
                    </group>
                    
                    <group string="Detalles de Daños Previos" col="2" invisible="not new_vehicle_has_damage">
                        <field name="new_vehicle_damage_description" colspan="2" nolabel="1"/>
                        <button name="action_open_new_damage_painter" 
                                string="Pintar Daños" 
                                type="object" 
                                class="btn-secondary" 
                                icon="fa-paint-brush"/>
                        <field name="new_vehicle_painted_damage_image" 
                               widget="image" 
                               options="{'size': [400, 300]}"
                               colspan="2"
                               nolabel="1"
                               invisible="not new_vehicle_painted_damage_image"/>
                    </group>
                    
                    <!-- Botones de navegación Paso 3 -->
                    <group col="2" colspan="2">
                        <div>
                            <button string="Anterior" 
                                    name="action_previous_step" 
                                    type="object" 
                                    class="btn-secondary"
                                    icon="fa-arrow-left"/>
                        </div>
                        <div class="float-end">
                            <button string="Siguiente" 
                                    name="action_next_step" 
                                    type="object" 
                                    class="btn-primary"
                                    icon="fa-arrow-right"/>
                        </div>
                    </group>
                </group>
                
                <!-- PASO 4: Confirmación y Documentos -->
                <group invisible="step != '4_confirm'">
                    <div class="alert alert-success" role="alert" col="2">
                        <h4><i class="fa fa-check-circle"/> Paso 4 de 4: Confirmación</h4>
                        <p>Revise los datos y confirme la sustitución del vehículo.</p>
                    </div>
                    
                    <group string="Resumen de la Sustitución" col="2">
                        <label for="old_vehicle_id" string="Vehículo que se retira"/>
                        <div>
                            <field name="old_vehicle_id" readonly="1" nolabel="1" class="oe_inline"/>
                            (<field name="old_vehicle_license_plate" readonly="1" nolabel="1" class="oe_inline"/>)
                        </div>
                        <field name="old_vehicle_odometer" string="Kilometraje final" readonly="1"/>
                        <field name="old_vehicle_fuel_level" string="Combustible" readonly="1"/>
                        <field name="old_vehicle_has_damage" string="¿Tiene daños?" readonly="1"/>
                        <field name="old_vehicle_damage_amount" string="Monto de daños" readonly="1" invisible="not old_vehicle_has_damage"/>
                        
                        <separator colspan="2"/>
                        
                        <label for="new_vehicle_id" string="Vehículo que se entrega" class="text-success"/>
                        <div>
                            <field name="new_vehicle_id" readonly="1" nolabel="1" class="oe_inline text-success"/>
                            (<field name="new_vehicle_license_plate" readonly="1" nolabel="1" class="oe_inline"/>)
                        </div>
                        <field name="new_vehicle_odometer" string="Kilometraje inicial" readonly="1"/>
                        <field name="new_vehicle_fuel_level" string="Combustible" readonly="1"/>
                    </group>
                    
                    <group string="Diferencia de Precio" col="2" invisible="not has_price_difference">
                        <field name="old_vehicle_rent" readonly="1"/>
                        <field name="new_vehicle_rent" readonly="1"/>
                        <field name="price_difference" readonly="1" class="oe_inline"/>
                        <field name="apply_price_difference"/>
                        <div colspan="2" class="alert alert-warning" role="alert" invisible="price_difference == 0">
                            <i class="fa fa-exclamation-triangle"/> 
                            <span invisible="price_difference &lt;= 0">
                                El cliente deberá pagar <strong><field name="price_difference" nolabel="1" class="oe_inline"/> 
                                <field name="currency_id" nolabel="1" class="oe_inline" invisible="1"/>
                                </strong> adicionales.
                            </span>
                            <span invisible="price_difference &gt; 0">
                                Se devolverá al cliente <strong><field name="price_difference" nolabel="1" class="oe_inline"/> 
                                <field name="currency_id" nolabel="1" class="oe_inline" invisible="1"/>
                                </strong>.
                            </span>
                        </div>
                    </group>
                    
                    <group string="Documentación" col="2">
                        <field name="generate_addendum"/>
                        <div colspan="2" class="alert alert-info" role="alert" invisible="not generate_addendum">
                            <i class="fa fa-file-text-o"/> 
                            Se generará un addendum/anexo al contrato que será firmado por ambas partes.
                        </div>
                    </group>
                    
                    <group string="Firmas" col="2">
                        <group>
                            <label for="customer_signature" string="Firma del Cliente"/>
                            <field name="customer_signature" widget="signature" nolabel="1"/>
                        </group>
                        <group>
                            <label for="company_signature" string="Firma de la Empresa"/>
                            <field name="company_signature" widget="signature" nolabel="1"/>
                        </group>
                    </group>
                    
                    <!-- Botones de navegación Paso 4 -->
                    <group col="2" colspan="2">
                        <div>
                            <button string="Anterior" 
                                    name="action_previous_step" 
                                    type="object" 
                                    class="btn-secondary"
                                    icon="fa-arrow-left"/>
                        </div>
                        <div class="float-end">
                            <button string="Confirmar Sustitución" 
                                    name="action_confirm_substitution" 
                                    type="object" 
                                    class="btn-success"
                                    icon="fa-check"/>
                        </div>
                    </group>
                </group>
                
                <footer>
                    <!-- Botones de navegación -->
                    <button string="Anterior" 
                            name="action_previous_step" 
                            type="object" 
                            class="btn-secondary"
                            invisible="step == '1_old_vehicle'"/>
                    
                    <button string="Siguiente" 
                            name="action_next_step" 
                            type="object" 
                            class="btn-primary"
                            invisible="step == '4_confirm'"/>
                    
                    <button string="Confirmar Sustitución" 
                            name="action_confirm_substitution" 
                            type="object" 
                            class="btn-success"
                            invisible="step != '4_confirm'"/>
                    
                    <button string="Cancelar" 
                            special="cancel" 
                            class="btn-default"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_vehicle_substitution_wizard" model="ir.actions.act_window">
        <field name="name">Sustitución de Vehículo</field>
        <field name="res_model">vehicle.substitution.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_vehicle_contract"/>
        <field name="binding_view_types">form</field>
    </record>

</odoo>

