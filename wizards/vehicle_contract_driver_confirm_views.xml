<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="vehicle_contract_driver_confirm_form" model="ir.ui.view">
        <field name="name">vehicle.contract.driver.confirm.form</field>
        <field name="model">vehicle.contract.driver.confirm</field>
        <field name="arch" type="xml">
            <form string="Entregar sin conductor">
                <div class="alert alert-warning" role="alert">
                    El contrato no tiene <strong>conductor autorizado</strong>.
                    Puede añadirlo ahora en el contrato o entregar el vehículo igualmente.
                </div>
                <field name="contract_ids" widget="many2many_tags" readonly="1" force_save="1"/>
                <footer>
                    <button string="Entregar sin conductor" name="action_confirm" type="object"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Volver y añadir conductor" special="cancel" class="btn-secondary"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
