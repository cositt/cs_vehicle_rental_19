<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="rental_contract_booking_form_view" model="ir.ui.view">
            <field name="name">rental.contract.booking.form.view</field>
            <field name="model">rental.contract.booking</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="customer_id" required="1"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="start_date" required="1"/>
                        </group>
                        <group>
                            <field name="company_id" required="1"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   string="Compañía"/>
                            <field name="end_date" required="1"/>
                        </group>
                    </group>
                    
                    <group>
                        <group>
                            <field name="selected_category_id" required="1" string="Tipo de Vehículo"/>
                            <field name="duration_range" required="1" string="Duración"/>
                        </group>
                        <group>
                            <field name="search_vehicle" placeholder="Buscar por marca o modelo"/>
                            <field name="km_range" required="1" string="Rango de Km"/>
                        </group>
                    </group>
                    
                    <group>
                        <group>
                            <field name="pricing_type" required="1" string="Tipo de Tarifa"/>
                        </group>
                        <group>
                            <field name="calculated_price" readonly="1" string="Tarifa (€/día)"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page name="fleet_vehicles" string="Vehículos Disponibles"
                              invisible="start_date == False or end_date == False or selected_category_id == False">
                            <field name="fleet_vehicle_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="model_id"/>
                                    <field name="license_plate"/>
                                    <field name="model_year"/>
                                    <field name="transmission"/>
                                    <field name="fuel_type"/>
                                    <field name="category_id"/>
                                    <button string="Reservar" name="action_create_book_contract_from_wizard" type="object"
                                            class="btn btn-outline-info"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <footer>
                        <button string="Cancelar" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="action_rental_contract_booking" model="ir.actions.act_window">
            <field name="name">Reserva de Contrato</field>
            <field name="res_model">rental.contract.booking</field>
            <field name="target">new</field>
            <field name="view_id" ref="rental_contract_booking_form_view"/>
        </record>
    </data>
</odoo>
