<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="damage_painter_wizard_form" model="ir.ui.view">
            <field name="name">vehicle.contract.damage.painter.form</field>
            <field name="model">vehicle.contract.damage.painter</field>
            <field name="arch" type="xml">
                <form string="Editor de Daños del Vehículo">
                    <sheet>
                        <div class="oe_title">
                            <h1>Editor de Daños del Vehículo</h1>
                        </div>
                        <group>
                            <field name="contract_id" invisible="1" class="js_contract_id_field"/>
                            <field name="base_image" invisible="1"/>
                            <field name="damage_image" invisible="1" force_save="1"/>
                        </group>
                        
                        <div class="damage_painter_container">
                            <div class="damage_painter_toolbar" style="margin-bottom: 10px; padding: 10px; background-color: #f5f5f5; border-radius: 5px;">
                                <span class="btn btn-primary damage_tool" data-tool="marker" style="margin-right: 5px; cursor: pointer; display: inline-block; padding: 5px 10px;">
                                    <i class="fa fa-paint-brush"/> Marcador
                                </span>
                                <span class="btn btn-info damage_tool" data-tool="text" style="margin-right: 5px; cursor: pointer; display: inline-block; padding: 5px 10px;">
                                    <i class="fa fa-font"/> Texto
                                </span>
                                <span class="btn btn-warning damage_tool" data-tool="eraser" style="margin-right: 5px; cursor: pointer; display: inline-block; padding: 5px 10px;">
                                    <i class="fa fa-eraser"/> Borrador
                                </span>
                                <span style="margin: 0 10px;">|</span>
                                <span class="damage_color" data-color="#FF8C00" style="background-color: #FF8C00; margin-right: 5px; width: 40px; height: 30px; display: inline-block; cursor: pointer; border: 2px solid #ddd; border-radius: 3px;"></span>
                                <span class="damage_color" data-color="#FFD700" style="background-color: #FFD700; margin-right: 5px; width: 40px; height: 30px; display: inline-block; cursor: pointer; border: 2px solid #ddd; border-radius: 3px;"></span>
                                <span style="margin: 0 10px;">|</span>
                                <span style="margin-right: 5px; font-weight: bold;">Grosor:</span>
                                <input type="range" class="damage_line_width" min="1" max="20" value="3" style="width: 100px; margin-right: 10px;"/>
                                <span class="line_width_display">3</span>
                                <span style="margin: 0 10px;">|</span>
                                <span style="margin-right: 5px; font-weight: bold;">Tamaño texto:</span>
                                <input type="range" class="damage_font_size" min="12" max="48" value="16" style="width: 100px; margin-right: 10px;"/>
                                <span class="font_size_display">16</span>
                                <span style="margin: 0 10px;">|</span>
                                <span class="btn btn-success o_download_damage_btn" style="padding: 5px 15px; cursor: pointer;">
                                    <i class="fa fa-download"/> Descargar
                                </span>
                            </div>
                            <div style="border: 2px solid #ccc; display: inline-block; background-color: white;">
                                <canvas id="damage_canvas" width="800" height="600" style="cursor: crosshair; display: block;"></canvas>
                            </div>
                        </div>
                    </sheet>
                    <footer>
                        <button string="Guardar" name="save_damage_image" type="object" class="btn-primary o_save_damage_btn"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>

