            <field name="categ_id" ref="vehicle_rental.product_category_vehicle"/>
        </record>

        <!-- Tipo P - Furgoneta 8/10m³ -->
        <record id="product_rental_tipo_p" model="product.template">
            <field name="name">Alquiler Tipo P - Furgoneta 8/10m³</field>
