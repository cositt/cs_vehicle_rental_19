<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!-- ============================================ -->
        <!-- PRODUCTOS DE ALQUILER POR CATEGORÍA -->
        <!-- ============================================ -->
        
        <!-- Tipo A - Combi 5 plazas -->
        <record id="product_rental_tipo_a" model="product.template">
            <field name="name">Alquiler Tipo A - Combi 5 plazas</field>
            <field name="type">service</field>
            <field name="categ_id" ref="vehicle_rental.product_category_vehicle"/>
        </record>

        <!-- Tipo C - Furgoneta 3m³ -->
        <record id="product_rental_tipo_c" model="product.template">
            <field name="name">Alquiler Tipo C - Furgoneta 3m³</field>
            <field name="type">service</field>
            <field name="categ_id" ref="vehicle_rental.product_category_vehicle"/>
        </record>

        <!-- Tipo F - Furgoneta 5/6m³ -->
        <record id="product_rental_tipo_f" model="product.template">
            <field name="name">Alquiler Tipo F - Furgoneta 5/6m³</field>
