<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Crear permisos de acceso para vehicle.deposit.rule -->
        <record id="access_vehicle_deposit_rule_user" model="ir.model.access">
            <field name="name">access_vehicle_deposit_rule_user</field>
            <field name="model_id" ref="model_vehicle_deposit_rule"/>
            <field name="group_id" ref="base.group_user"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="access_vehicle_deposit_rule_manager" model="ir.model.access">
            <field name="name">access_vehicle_deposit_rule_manager</field>
            <field name="model_id" ref="model_vehicle_deposit_rule"/>
            <field name="group_id" ref="base.group_system"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

    </data>
</odoo>
